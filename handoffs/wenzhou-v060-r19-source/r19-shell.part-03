function sample(ds,x,z){const b=ds.bbox;if(x<b[0]||x>b[2]||z<b[1]||z>b[3])return NaN;const u=(x-b[0])/(b[2]-b[0])*(ds.width-1),v=(z-b[1])/(b[3]-b[1])*(ds.height-1),c=clamp(Math.floor(u),0,ds.width-2),r=clamp(Math.floor(v),0,ds.height-2),fu=u-c,fv=v-r,i=(rr,cc)=>rr*ds.width+cc,a=ds.h[i(r,c)],bb=ds.h[i(r,c+1)],cc=ds.h[i(r+1,c)],d=ds.h[i(r+1,c+1)];if([a,bb,cc,d].some(q=>q===-32768))return NaN;return mix(mix(a,bb,fu),mix(cc,d,fu),fv)}function surface(x,z){if(state.detailVisible){const h=sample(state.detail,x,z);if(Number.isFinite(h))return h}return sample(state.overview,x,z)}
const CLOUDS=[
{label:'晴空',base:0,top:0,coverage:0,density:0,scale:.00008,stretch:1},
{label:'卷云',base:8000,top:12000,coverage:.30,density:.34,scale:.000095,stretch:.28},
{label:'卷积云',base:7000,top:11000,coverage:.43,density:.45,scale:.000150,stretch:.75},
{label:'卷层云',base:6000,top:12000,coverage:.82,density:.26,scale:.000040,stretch:.76},
{label:'高积云',base:3000,top:6000,coverage:.53,density:.76,scale:.000100,stretch:1.05},
{label:'高层云',base:2500,top:7000,coverage:.87,density:.42,scale:.000045,stretch:.95},
{label:'雨层云',base:600,top:6000,coverage:.95,density:.73,scale:.000037,stretch:1.05},
{label:'层积云',base:600,top:2200,coverage:.70,density:.70,scale:.000088,stretch:1.25},
{label:'层云',base:80,top:900,coverage:.96,density:.55,scale:.000032,stretch:1.00},
{label:'积云',base:700,top:3500,coverage:.44,density:.83,scale:.000112,stretch:1.00},
{label:'积雨云',base:600,top:14000,coverage:.38,density:.98,scale:.000120,stretch:.95}
];
const VIEWS={overview:{label:'整个温州',target:[0,180,0],yaw:-2.28,pitch:.70,distance:255000},approach:{label:'洞头接近',target:[17750,150,50450],yaw:-2.56,pitch:.44,distance:10900},fighter:{label:'1200 米飞行',target:[17750,150,50450],yaw:-2.844,pitch:.388,distance:2770},coast:{label:'海岸低空',target:[17720,115,50020],yaw:-2.72,pitch:.20,distance:900}};
function pose(){const cp=Math.cos(state.pitch);state.eye=[state.target[0]+Math.sin(state.yaw)*cp*state.distance,state.target[1]+Math.sin(state.pitch)*state.distance,state.target[2]+Math.cos(state.yaw)*cp*state.distance];const ground=surface(state.eye[0],state.eye[2]);if(Number.isFinite(ground)&&state.eye[1]<ground+3)state.eye[1]=ground+3}
function current(){return{target:[...state.target],yaw:state.yaw,pitch:state.pitch,distance:state.distance}}function flyTo(id,duration=1500){const v=VIEWS[id],from=current();state.view=id;state.fly={from,to:v,start:performance.now(),duration};state.lastInteraction=performance.now();$('#viewLabel').textContent=v.label;$$('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===id))}
function updateFly(now){if(!state.fly)return;const f=state.fly,t=clamp((now-f.start)/f.duration,0,1),e=t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;state.target=f.from.target.map((x,i)=>mix(x,f.to.target[i],e));let dy=((f.to.yaw-f.from.yaw+Math.PI*3)%(Math.PI*2))-Math.PI;state.yaw=f.from.yaw+dy*e;state.pitch=mix(f.from.pitch,f.to.pitch,e);state.distance=Math.exp(mix(Math.log(f.from.distance),Math.log(f.to.distance),e));if(t>=1){state.fly=null;state.lastInteraction=performance.now()}}
function resize(){const moving=performance.now()-state.lastInteraction<260||!!state.fly,cap=innerWidth<700?2048:2560,base=Math.min(devicePixelRatio||1,cap/Math.max(innerWidth,innerHeight),Math.sqrt(4096000/(innerWidth*innerHeight))),scale=moving?.78:1,w=Math.max(2,Math.round(innerWidth*base*scale)),h=Math.max(2,Math.round(innerHeight*base*scale));if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h}state.renderW=w;state.renderH=h;state.moving=moving}
function bindTex(p,name,unit,t){gl.activeTexture(gl.TEXTURE0+unit);gl.bindTexture(gl.TEXTURE_2D,t);gl.uniform1i(gl.getUniformLocation(p,name),unit)}
function patchBounds(ds,crop){const [x0,y0,x1,y1]=crop,b=ds.bbox;return[mix(b[0],b[2],x0/(ds.width-1)),mix(b[1],b[3],y0/(ds.height-1)),mix(b[0],b[2],x1/(ds.width-1)),mix(b[1],b[3],y1/(ds.height-1))]}

function setSurface(p,cfg,time){const ds=cfg.ds;gl.useProgram(p);gl.uniformMatrix4fv(gl.getUniformLocation(p,'uVP'),false,state.vp);gl.uniform2fv(gl.getUniformLocation(p,'uWorldMin'),ds.bbox.slice(0,2));gl.uniform2fv(gl.getUniformLocation(p,'uWorldMax'),ds.bbox.slice(2,4));gl.uniform2fv(gl.getUniformLocation(p,'uOverviewMin'),state.overview.bbox.slice(0,2));gl.uniform2fv(gl.getUniformLocation(p,'uOverviewMax'),state.overview.bbox.slice(2,4));gl.uniform2fv(gl.getUniformLocation(p,'uPatchMin'),cfg.patch.slice(0,2));gl.uniform2fv(gl.getUniformLocation(p,'uPatchMax'),cfg.patch.slice(2,4));gl.uniform2fv(gl.getUniformLocation(p,'uChildMin'),cfg.child.slice(0,2));gl.uniform2fv(gl.getUniformLocation(p,'uChildMax'),cfg.child.slice(2,4));gl.uniform2i(gl.getUniformLocation(p,'uSize'),ds.width,ds.height);gl.uniform2i(gl.getUniformLocation(p,'uOverviewSize'),state.overview.width,state.overview.height);gl.uniform1f(gl.getUniformLocation(p,'uSpacing'),ds.spacingM);gl.uniform1f(gl.getUniformLocation(p,'uOverviewSpacing'),state.overview.spacingM);gl.uniform1f(gl.getUniformLocation(p,'uTime'),time);gl.uniform1f(gl.getUniformLocation(p,'uPatchVisible'),cfg.visible?1:0);gl.uniform1f(gl.getUniformLocation(p,'uChildVisible'),cfg.childVisible?1:0);gl.uniform1i(gl.getUniformLocation(p,'uIsOverview'),cfg.overview?1:0);gl.uniform1i(gl.getUniformLocation(p,'uParentMode'),cfg.parentMode);gl.uniform1i(gl.getUniformLocation(p,'uParentStep'),cfg.parentStep||1);gl.uniform1i(gl.getUniformLocation(p,'uHasChild'),cfg.childVisible?1:0);gl.uniform3fv(gl.getUniformLocation(p,'uEye'),state.eye);gl.uniform3fv(gl.getUniformLocation(p,'uSun'),state.sun);gl.uniform3fv(gl.getUniformLocation(p,'uSunColor'),state.sunColor);gl.uniform3fv(gl.getUniformLocation(p,'uSkyTop'),state.skyTop);gl.uniform3fv(gl.getUniformLocation(p,'uSkyHorizon'),state.skyHorizon);gl.uniform1f(gl.getUniformLocation(p,'uHaze'),state.haze);gl.uniform1f(gl.getUniformLocation(p,'uMicro'),state.micro?1:0);gl.uniform1f(gl.getUniformLocation(p,'uWaterOn'),state.water?1:0);gl.uniform1i(gl.getUniformLocation(p,'uCloudType'),state.cloudType);gl.uniform1f(gl.getUniformLocation(p,'uCloudShadow'),state.cloudShadow?1:0);bindTex(p,'uHeight',0,ds.textures.height);bindTex(p,'uOverviewHeight',1,state.overview.textures.height);bindTex(p,'uClass',2,ds.textures.cls);bindTex(p,'uOverviewClass',3,state.overview.textures.cls);bindTex(p,'uShore',4,ds.textures.shore);bindTex(p,'uOverviewShore',5,state.overview.textures.shore);bindTex(p,'uFeature',6,ds.textures.feat);bindTex(p,'uOverviewFeature',7,state.overview.textures.feat)}
function drawMesh(mesh){gl.bindVertexArray(mesh.vao);gl.drawElements(gl.TRIANGLES,mesh.count,gl.UNSIGNED_INT,0);state.triangles+=mesh.triangles}
function draw(now){requestAnimationFrame(draw);const cadence=performance.now()-state.lastInteraction<280||!!state.fly?40:33;if(now-(state.lastDraw||0)<cadence)return;state.lastDraw=now;resize();updateFly(now);pose();state.showOuter=state.distance<100000||state.view!=='overview';state.showMid=state.showOuter&&state.distance<44000;state.showInner=state.showMid&&state.distance<12500&&!state.moving;state.detailVisible=state.showOuter;state.detailStep=!state.showOuter?0:state.showInner?1:state.showMid?2:4;const near=state.distance>100000?50:state.distance>20000?5:.3,far=Math.max(420000,state.distance*4);state.vp=mat4Mul(perspective(state.view==='overview'?Math.PI/3:Math.PI/3.55,state.renderW/state.renderH,near,far),lookAt(state.eye,state.target));state.invVP=invert(state.vp);gl.viewport(0,0,state.renderW,state.renderH);gl.disable(gl.DEPTH_TEST);gl.disable(gl.BLEND);const sky=state.programs.sky;gl.useProgram(sky);gl.uniformMatrix4fv(gl.getUniformLocation(sky,'uInvVP'),false,state.invVP);gl.uniform3fv(gl.getUniformLocation(sky,'uEye'),state.eye);gl.uniform3fv(gl.getUniformLocation(sky,'uSun'),state.sun);gl.uniform3fv(gl.getUniformLocation(sky,'uSunColor'),state.sunColor);gl.uniform3fv(gl.getUniformLocation(sky,'uTop'),state.skyTop);gl.uniform3fv(gl.getUniformLocation(sky,'uHorizon'),state.skyHorizon);const cp=CLOUDS[state.cloudType];gl.uniform1f(gl.getUniformLocation(sky,'uTime'),now*.001);gl.uniform1i(gl.getUniformLocation(sky,'uCloudType'),state.cloudType);gl.uniform1f(gl.getUniformLocation(sky,'uCloudBase'),cp.base);gl.uniform1f(gl.getUniformLocation(sky,'uCloudTop'),cp.top);gl.uniform1f(gl.getUniformLocation(sky,'uCloudCoverage'),cp.coverage);gl.uniform1f(gl.getUniformLocation(sky,'uCloudDensity'),cp.density);gl.uniform1f(gl.getUniformLocation(sky,'uCloudQuality'),state.moving||state.renderW*state.renderH>1100000?0:1);gl.uniform1f(gl.getUniformLocation(sky,'uCloudScale'),cp.scale);gl.uniform1f(gl.getUniformLocation(sky,'uCloudStretch'),cp.stretch);bindTex3D(sky,'uCloud