vec3 worldAt(vec2 uv){vec4 p=uInvVP*vec4(uv*2.-1.,1.,1.);return p.xyz/p.w;}float hash21(vec2 p){p=fract(p*vec2(.1031,.11369));p+=dot(p,p.yx+19.19);return fract((p.x+p.y)*p.x);}float sampleVolume(vec3 p){float y=clamp(p.y,0.,1.);vec3 a=vec3(p.x,p.y,p.z),b=vec3(-p.z*1.91+.37,y*1.23,p.x*1.91+.19);float n=texture(uCloudNoise,a).r*.72+texture(uCloudNoise,b).r*.28;return n;}
float densityAt(vec3 world){float span=max(1.,uCloudTop-uCloudBase),y=(world.y-uCloudBase)/span;if(y<=0.||y>=1.)return 0.;vec2 wind=vec2(uTime*.000045,uTime*.000018);vec3 p=vec3(world.x*uCloudScale+wind.x,y,world.z*uCloudScale+wind.y);p.x*=uCloudStretch;float n=sampleVolume(p);float threshold=mix(.78,.43,uCloudCoverage);float profile;if(uCloudType==1)profile=pow(sin(3.14159265*y),.22);else if(uCloudType==3||uCloudType==5||uCloudType==6||uCloudType==8)profile=pow(sin(3.14159265*y),.34);else profile=smoothstep(0.,.12,y)*smoothstep(1.,.68,y);if(uCloudType==10)profile=max(profile,smoothstep(.32,.88,y)*.72);float body=smoothstep(threshold,threshold+.13,n);float erosion=sampleVolume(p*vec3(2.33,1.35,2.33)+vec3(.31,.17,.63));body=clamp(body-(1.-body)*(erosion-.48)*.55,0.,1.);return body*profile*uCloudDensity;}
