float hash21(vec2 p){p=fract(p*vec2(.1031,.11369));p+=dot(p,p.yx+19.19);return fract((p.x+p.y)*p.x);}float n2(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(hash21(i),hash21(i+vec2(1,0)),f.x),mix(hash21(i+vec2(0,1)),hash21(i+vec2(1,1)),f.x),f.y);}float fbm(vec2 p){float s=0.,a=.55;mat2 r=mat2(.80,-.60,.60,.80);for(int i=0;i<4;i++){s+=a*n2(p);p=r*p*2.03+vec2(7.13,3.71);a*=.5;}return s/.997;}float F(vec2 p,vec2 mn,vec2 mx){vec2 uv=(p-mn)/(mx-mn),e=min(uv,1.-uv);return smoothstep(0.,.11,min(e.x,e.y));}float sat(float x){return clamp(x,0.,1.);}vec3 tone(vec3 c){c=max(c,0.);c=(c*(2.51*c+.03))/(c*(2.43*c+.59)+.14);return pow(clamp(c,0.,1.),vec3(1./2.2));}float cloudShade(vec2 p){if(uCloudType==0||uCloudShadow<.5)return 1.;float sc=uCloudType<4?.00004:uCloudType<7?.00007:.00011;float n=.67*fbm(p*sc+vec2(uTime*.002,uTime*.0007))+.33*fbm(p*sc*2.1-vec2(uTime*.001,uTime*.0018));float t=uCloudType==6?.48:uCloudType==8?.45:uCloudType==10?.50:.60;return 1.-smoothstep(t,t+.14,n)*(uCloudType==6?.24:uCloudType==10?.22:.14);}
