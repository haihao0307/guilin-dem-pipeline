function mat4Mul(a,b){const o=new Float32Array(16);for(let c=0;c<4;c++)for(let r=0;r<4;r++){let s=0;for(let k=0;k<4;k++)s+=a[k*4+r]*b[c*4+k];o[c*4+r]=s}return o}function perspective(fov,aspect,near,far){const f=1/Math.tan(fov/2),nf=1/(near-far),o=new Float32Array(16);o[0]=f/aspect;o[5]=f;o[10]=(far+near)*nf;o[11]=-1;o[14]=2*far*near*nf;return o}function norm(v){const l=Math.hypot(...v)||1;return v.map(x=>x/l)}function sub(a,b){return a.map((x,i)=>x-b[i])}function cross(a,b){return[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]]}function lookAt(e,t){const z=norm(sub(e,t)),x=norm(cross([0,1,0],z)),y=cross(z,x),o=new Float32Array(16);o[0]=x[0];o[1]=y[0];o[2]=z[0];o[4]=x[1];o[5]=y[1];o[6]=z[1];o[8]=x[2];o[9]=y[2];o[10]=z[2];o[12]=-x[0]*e[0]-x[1]*e[1]-x[2]*e[2];o[13]=-y[0]*e[0]-y[1]*e[1]-y[2]*e[2];o[14]=-z[0]*e[0]-z[1]*e[1]-z[2]*e[2];o[15]=1;return o}function invert(a){const out=new Float32Array(16),m=a;const b00=m[0]*m[5]-m[1]*m[4],b01=m[0]*m[6]-m[2]*m[4],b02=m[0]*m[7]-m[3]*m[4],b03=m[1]*m[6]-m[2]*m[5],b04=m[1]*m[7]-m[3]*m[5],b05=m[2]*m[7]-m[3]*m[6],b06=m[8]*m[13]-m[9]*m[12],b07=m[8]*m[14]-m[10]*m[12],b08=m[8]*m[15]-m[11]*m[12],b09=m[9]*m[14]-m[10]*m[13],b10=m[9]*m[15]-m[11]*m[13],b11=m[10]*m[15]-m[11]*m[14],det=b00*b11-b01*b10+b02*b09+b03*b08-b04*b07+b05*b06;if(!det)return out;const d=1/det;out[0]=(m[5]*b11-m[6]*b10+m[7]*b09)*d;out[1]=(-m[1]*b11+m[2]*b10-m[3]*b09)*d;out[2]=(m[13]*b05-m[14]*b04+m[15]*b03)*d;out[3]=(-m[9]*b05+m[10]*b04-m[11]*b03)*d;out[4]=(-m[4]*b11+m[6]*b08-m[7]*b07)*d;out[5]=(m[0]*b11-m[2]*b08+m[3]*b07)*d;out[6]=(-m[12]*b05+m[14]*b02-m[15]*b01)*d;out[7]=(m[8]*b05-m[10]*b02+m[11]*b01)*d;out[8]=(m[4]*b10-m[5]*b08+m[7]*b06)*d;out[9]=(-m[0]*b10+m[1]*b08-m[3]*b06)*d;out[10]=(m[12]*b04-m[13]*b02+m[15]*b00)*d;out[11]=(-m[8]*b04+m[9]*b02-m[11]*b00)*d;out[12]=(-m[4]*b09+m[5]*b07