function fatal(e){const text=String(e?.stack||e);state.errors.push(text);$('#error').style.display='block';$('#error').textContent=text;$('#loading').classList.add('hidden');console.error(e)}
addEventListener('error',e=>fatal(e.error||e.message));addEventListener('unhandledrejection',e=>fatal(e.reason));
function progress(x,t){$('#bar').style.width=Math.round(x*100)+'%';$('#loadText').textContent=t}
function b64(s){const bin=atob(s),a=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)a[i]=bin.charCodeAt(i);return a}
async function gunzip(s){const a=b64(s);const ab=await new Response(new Blob([a]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer();return new Uint8Array(ab)}
function tex(internal,format,type,w,h,data,filter=gl.NEAREST){const t=gl.createTexture();gl.bindTexture(gl.TEXTURE_2D,t);gl.pixelStorei(gl.UNPACK_ALIGNMENT,1);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MIN_FILTER,filter);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_MAG_FILTER,filter);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_S,gl.CLAMP_TO_EDGE);gl.texParameteri(gl.TEXTURE_2D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);gl.texImage2D(gl.TEXTURE_2D,0,internal,w,h,0,format,type,data);return t}
function makeCloudVolume(w=48,h=28,d=48){
  const out=new Uint8Array(w*h*d),fade=t=>t*t*(3-2*t),wrap=(n,m)=>(n%m+m)%m;
  const hash=(x,y,z,seed)=>{let n=(Math.imul(x,374761393)+Math.imul(y,668265263)+Math.imul(z,1442695041)+Math.imul(seed,69069))|0;n=Math.imul(n^(n>>>13),1274126177);return((n^(n>>>16))>>>0)/4294967295};
  const value=(u,v,q,cx,cy,cz,seed)=>{const x=u*cx,y=v*cy,z=q*cz,ix=Math.floor(x),iy=Math.floor(y),iz=Math.floor(z),fx=fade(x-ix),fy=fade(y-iy),fz=fade(z-iz),H=(dx,dy,dz)=>hash(wrap(ix+dx,cx),Math.max(0,Math.min(cy,iy+dy)),wrap(iz+dz,cz),seed),x00=mix(H(0,0,0),H(1,0,0),fx),x10=mix(H(0,1,0),H(1,1,0),fx),x01=mix(H(0,0,1),H(1,0,1),fx),x11=mix(H(0,1,1),H(1,1,1),fx);return mix(mix(x00,x10,fy),mix(x01,x11,fy),fz)};
  for(let z=0;z<d;z++)for(let y=0;y<h;y++)for(let x=0;x<w;x++){const u=x/w,v=y/(h-1),q=z/d;let n=0,a=.56,sum=0;for(const o of [[3,2,3,17],[6,4,6,31],[12,8,12,53],[24,16,24,79]]){n+=value(u,v,q,o[0],o[1],o[2],o[3])*a;sum+=a;a*=.48}out[(z*h+y)*w+x]=Math.round(Math.max(0,Math.min(1,Math.pow(n/sum,.94)))*255)}
  const t=gl.createTexture();gl.bindTexture(gl.TEXTURE_3D,t);gl.pixelStorei(gl.UNPACK_ALIGNMENT,1);gl.texParameteri(gl.TEXTURE_3D,gl.TEXTURE_MIN_FILTER,gl.LINEAR);gl.texParameteri(gl.TEXTURE_3D,gl.TEXTURE_MAG_FILTER,gl.LINEAR);gl.texParameteri(gl.TEXTURE_3D,gl.TEXTURE_WRAP_S,gl.REPEAT);gl.texParameteri(gl.TEXTURE_3D,gl.TEXTURE_WRAP_R,gl.REPEAT);gl.texParameteri(gl.TEXTURE_3D,gl.TEXTURE_WRAP_T,gl.CLAMP_TO_EDGE);gl.texImage3D(gl.TEXTURE_3D,0,gl.R8,w,h,d,0,gl.RED,gl.UNSIGNED_BYTE,out);return t
}
function bindTex3D(p,name,unit,t){gl.activeTexture(gl.TEXTURE0+unit);gl.bindTexture(gl.TEXTURE_3D,t);gl.uniform1i(gl.getUniformLocation(p,name),unit)}
async function decode(meta){const [hb,cb,sb,fb]=await Promise.all([gunzip(meta.heightGzip),gunzip(meta.classGzip),gunzip(meta.shoreGzip),gunzip(meta.featuresGzip)]);const ds={...meta,h:new Int16Array(hb.buffer,hb.byteOffset,hb.byteLength/2),cls:new Uint8Array(cb.buffer,cb.byteOffset,cb.byteLength),shore:new Uint16Array(sb.buffer,sb.byteOffset,sb.byteLength/2),feat:new Uint8Array(fb.buffer,fb.byteOffset,fb.byteLength),textures:{}};const n=ds.width*ds.height;if(ds.h.length!==n||ds.cls.length!==n||ds.shore.length!==n||ds.feat.length!==n*4)throw Error('数字网格长度不符 '+meta.id);ds.textures.height=tex(gl.R16I,gl.RED_INTEGER,gl.SHORT,ds.width,ds.height,ds.h);ds.textures.cls=tex(gl.R8UI,gl.RED_INTEGER,gl.UNSIGNED_BYTE,ds.width,ds.height,ds.cls);ds.textures.shore=tex(gl.R16UI,gl.RED_INTEGER,gl.UNSIGNED_SHORT,ds.width,ds.height,ds.shore);ds.textures.feat=tex(gl.RGBA8,gl.RGBA,gl.UNSIGNED_BYTE,ds.width,ds.height,ds.feat,gl.LINEAR);return ds}
function shader(type,src){const s=gl.createShader(type);gl.shaderSource(s,src);gl.compileShader(s);if(!gl.getShaderParameter(s,gl.COMPILE_STATUS))throw Error(gl.getShaderInfoLog(s));return s}
function program(vs,fs){const p=gl.createProgram();gl.attachShader(p,shader(gl.VERTEX_SHADER,vs));gl.attachShader(p,shader(gl.FRAGMENT_SHADER,fs));gl.linkProgram(p);if(!gl.getProgramParameter(p,gl.LINK_STATUS))throw Error(gl.getProgramInfoLog(p));return p}
function gridMesh(w,h,step=1,crop=[0,0,w-1,h-1]){const [x0,y0,x1,y1]=crop,cols=[];for(let x=x0;x<x1;x+=step)cols.push(x);if(cols.at(-1)!==x1)cols.push(x1);const rows=[];for(let y=y0;y<y1;y+=step)rows.push(y);if(rows.at(-1)!==y1)rows.push(y1);const W=cols.length,H=rows.length,v=new Float32Array(W*H*2);for(let y=0;y<H;y++)for(let x=0;x<W;x++){const i=(y*W+x)*2;v[i]=cols[x]/(w-1);v[i+1]=rows[y]/(h-1)}const ind=new Uint32Array((W-1)*(H-1)*6);let k=0;for(let y=0;y<H-1;y++)for(let x=0;x<W-1;x++){const i=y*W+x;ind.set([i,i+W,i+1,i+1,i+W,i+W+1],k);k+=6}const vao=gl.createVertexArray();gl.bindVertexArray(vao);const vb=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,vb);gl.bufferData(gl.ARRAY_BUFFER,v,gl.STATIC_DRAW);gl.enableVertexAttribArray(0);gl.vertexAttribPointer(0,2,gl.FLOAT,false,8,0);const ib=gl.createBuffer();gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,ib);gl.bufferData(gl.ELEMENT_ARRAY_BUFFER,ind,gl.STATIC_DRAW);gl.bindVertexArray(null);return{vao,count:ind.length,triangles:ind.length/3,step,W,H}}
const VS=`#version 300 es
