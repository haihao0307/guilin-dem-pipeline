layout(location=0)in vec2 aUV;uniform mat4 uVP;uniform isampler2D uHeight,uOverviewHeight;uniform usampler2D uClass,uOverviewClass;uniform ivec2 uSize,uOverviewSize;uniform vec2 uWorldMin,uWorldMax,uOverviewMin,uOverviewMax,uPatchMin,uPatchMax;uniform float uSpacing,uOverviewSpacing,uTime,uPatchVisible;uniform int uIsOverview,uParentMode,uParentStep;out vec2 vUV,vOverviewUV;out vec3 vWorld,vNormal;out float vPatchWeight,vSeaMix,vValid;
float H(isampler2D t,ivec2 sz,ivec2 q){q=clamp(q,ivec2(0),sz-1);return float(texelFetch(t,q,0).r);}float C(usampler2D t,ivec2 sz,ivec2 q){q=clamp(q,ivec2(0),sz-1);return float(texelFetch(t,q,0).r);}vec2 OUV(vec2 p){return clamp((p-uOverviewMin)/(uOverviewMax-uOverviewMin),0.,1.);}float OH(vec2 p){vec2 f=OUV(p)*vec2(uOverviewSize-1);ivec2 q=ivec2(floor(f));vec2 a=fract(f);float a0=H(uOverviewHeight,uOverviewSize,q),b=H(uOverviewHeight,uOverviewSize,q+ivec2(1,0)),c=H(uOverviewHeight,uOverviewSize,q+ivec2(0,1)),d=H(uOverviewHeight,uOverviewSize,q+ivec2(1,1));if(a0<-32000.)a0=0.;if(b<-32000.)b=a0;if(c<-32000.)c=a0;if(d<-32000.)d=a0;return mix(mix(a0,b,a.x),mix(c,d,a.x),a.y);}float OC(vec2 p){ivec2 q=ivec2(round(OUV(p)*vec2(uOverviewSize-1)));return C(uOverviewClass,uOverviewSize,q);}float OV(vec2 p){return OC(p)==255.?0.:1.;}float OS(vec2 p){return OC(p)==1.?1.:0.;}float TH(ivec2 q){float h=H(uHeight,uSize,q);return h<-32000.?0.:h;}float PH(vec2 uv){float st=float(max(uParentStep,1));vec2 f=uv*vec2(uSize-1),b=floor(f/st)*st,n=min(b+st,vec2(uSize-1)),a=(f-b)/max(n-b,vec2(1.));ivec2 q0=ivec2(b),q1=ivec2(n);float h00=TH(q0),h10=TH(ivec2(q1.x,q0.y)),h01=TH(ivec2(q0.x,q1.y)),h11=TH(q1);return a.x+a.y<=1.?h00+a.x*(h10-h00)+a.y*(h01-h00):h11+(1.-a.y)*(h10-h11)+(1.-a.x)*(h01-h11);}float PS(vec2 uv){float st=float(max(uParentStep,1));ivec2 q=ivec2(round(round(uv*vec2(uSize-1)/st)*st));return C(uClass,uSize,q)==1.?1.:0.;}float F(vec2 p,vec2 mn,vec2 mx){vec2 uv=(p-mn)/(mx-mn),e=min(uv,1.-uv);return smoothstep(0.,.11,min(e.x,e.y));}float W(vec2 p){return F(p,uPatchMin,uPatchMax)*uPatchVisible;}float wave(vec2 p){return .38*sin(dot(p,normalize(vec2(.86,.51)))*.0047+uTime*.58)+.17*sin(dot(p,normalize(vec2(-.31,.95)))*.0071-uTime*.43)+.08*sin(dot(p,normalize(vec2(.58,-.82)))*.012+uTime*.29);}
void main(){vec2 p=mix(uWorldMin,uWorldMax,aUV);ivec2 q=ivec2(round(aUV*vec2(uSize-1)));float h,sea,valid,w=uIsOverview==1?1.:W(p);vec3 n;if(uIsOverview==1){h=OH(p);sea=OS(p);valid=OV(p);float sp=uOverviewSpacing;n=normalize(vec3(-(OH(p+vec2(sp,0))-OH(p-vec2(sp,0)))/(2.*sp),1.,-(OH(p+vec2(0,sp))-OH(p-vec2(0,sp)))/(2.*sp)));}else{h=TH(q);float l=TH(q+ivec2(-1,0)),r=TH(q+ivec2(1,0)),u=TH(q+ivec2(0,-1)),d=TH(q+ivec2(0,1));n=normalize(vec3(-(r-l)/(2.*uSpacing),1.,-(d-u)/(2.*uSpacing)));float cls=C(uClass,uSize,q);sea=cls==1.?1.:0.;valid=cls==255.?0.:1.;}if(uParentMode==1){float ph=OH(p),ps=OS(p),sp=uOverviewSpacing;vec3 pn=normalize(vec3(-(OH(p+vec2(sp,0))-OH(p-vec2(sp,0)))/(2.*sp),1.,-(OH(p+vec2(0,sp))-OH(p-vec2(0,sp)))/(2.*sp)));h=mix(ph,h,w);sea=mix(ps,sea,w);valid=mix(OV(p),valid,w);n=normalize(mix(pn,n,w));}else if(uParentMode==2){float ph=PH(aUV),ps=PS(aUV),sp=uSpacing*float(max(uParentStep,1));vec2 du=vec2(sp/(uWorldMax.x-uWorldMin.x),0),dv=vec2(0,sp/(uWorldMax.y-uWorldMin.y));vec3 pn=normalize(vec3(-(PH(aUV+du)-PH(aUV-du))/(2.*sp),1.,-(PH(aUV+dv)-PH(aUV-dv))/(2.*sp)));h=mix(ph,h,w);sea=mix