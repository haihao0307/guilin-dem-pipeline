les.length}state.lastFrame=now;updateUI();window.__WZ_V060_LAB__={version:'wenzhou-v060-terrain-cloud-quality-lab-19',ready:state.ready,oneCanvas:document.querySelectorAll('canvas').length===1,full17TileCogMounted:false,stableWorkbenchTouched:false,overviewSpacingM:800,detailSourceSpacingM:12.5,detailDisplayStep:state.detailStep,detailVisible:state.detailVisible,activeRings:{outer:state.showOuter,mid:state.showMid,inner:state.showInner},activeTriangles:state.triangles,renderPixels:[state.renderW,state.renderH],fps:state.fps,cloud:{type:state.cloudType,label:CLOUDS[state.cloudType].label,baseM:CLOUDS[state.cloudType].base,topM:CLOUDS[state.cloudType].top,shadow:state.cloudShadow},terrainDisplay:{overviewTruthSpacingM:800,overviewDisplayInterpolation:state.showOuter&&!state.moving?'0.75-node-step':'native-node-step',microAffectsHeight:false},eye:[...state.eye],target:[...state.target],errors:[...state.errors],visualAcceptance:false,productionReady:false};if(state.demo&&!state.fly&&now>state.demoAt){const seq=['overview','approach','fighter','coast'],idx=(seq.indexOf(state.view)+1)%seq.length;flyTo(seq[idx],idx===0?2300:1700);state.demoAt=now+5200}}
function updateUI(){if(state.frame%8)return;const cp=CLOUDS[state.cloudType];$('#detailGrid').textContent=state.detailStep===1?'12.5 m 近域':state.detailStep===2?'25 m 近域':state.detailStep===4?'50 m 接近':'全域概览';$('#overviewDisplay').textContent=state.showOuter&&!state.moving?'约 600 m 平滑显示':'800 m';$('#cloudBounds').textContent=state.cloudType?`${cp.base.toLocaleString()}–${cp.top.toLocaleString()} m`:'晴空';$('#triangles').textContent=state.triangles.toLocaleString();$('#pixels').textContent=`${state.renderW} × ${state.renderH}`;$('#fps').textContent=state.fps?state.fps.toFixed(0)+' FPS':'读取中';const g=surface(state.eye[0],state.eye[2]);$('#clearance').textContent=Number.isFinite(g)?Math.max(0,state.eye[1]-g).toFixed(0)+' m':'域外';$('#qualityText').textContent=state.moving?'响应中':'清晰收敛';$('#badge').innerHTML=`<strong>${state.detailStep===1?'12.5 m 数字近域':state.showOuter?'连续精度接近':'温州全域概览'}</strong> · ${cp.label}${state.cloudType?' '+cp.base+'–'+cp.top+' m':''} · ${state.moving?'操作响应':'静止高质量'}`}
function installControls(){let drag=null,touches=new Map();canvas.addEventListener('pointerdown',e=>{canvas.setPointerCapture(e.pointerId);touches.set(e.pointerId,[e.clientX,e.clientY]);drag={x:e.clientX,y:e.clientY,id:e.pointerId};state.lastInteraction=performance.now();state.fly=null});canvas.addEventListener('pointermove',e=>{if(!touches.has(e.pointerId))return;const old=touches.get(e.pointerId);touches.set(e.pointerId,[e.clientX,e.clientY]);state.lastInteraction=performance.now();if(touches.size===1&&drag){const dx=e.clientX-drag.x,dy=e.clientY-drag.y;drag.x=e.clientX;drag.y=e.clientY;state.yaw-=dx*.004;state.pitch=clamp(state.pitch+dy*.003,.035,1.45)}else if(touches.size===2){const pts=[...touches.values()],d=Math.hypot(pts[0][0]-pts[1][0],pts[0][1]-pts[1][1]);if(state.pinch){state.distance=clamp(state.pinch.distance*state.pinch.d/d,180,520000)}else state.pinch={d,distance:state.distance}}});function up(e){touches.delete(e.pointerId);drag=null;if(touches.size<2)state.pinch=null;state.lastInteraction=performance.now()}canvas.addEventListener('pointerup',up);canvas.addEventListener('pointercancel',up);canvas.addEventListener('wheel',e=>{e.preventDefault();state.fly=null;state.distance=clamp(state.distance*Math.exp(e.deltaY*.001),180,520000);state.lastInteraction=performance.now()},{passive:false});canvas.addEventListener('dblclick',()=>flyTo('fighter',1000));$('#menuButton').onclick=()=>{const open=$('#sheet').classList.toggle('open');document.body.classList.toggle('sheet-open',open);$('#menuButton').textContent=open?'×':'☰'};$$('[data-view]').forEach(b=>b.onclick=()=>flyTo(b.dataset.view));$('#waterToggle').onchange=e=>state.water=e.target.checked;$('#microToggle').onchange=e=>state.micro=e.target.checked;$('#shadowToggle').onchange=e=>state.cloudShadow=e.target.checked;$$('[data-cloud]').forEach(b=>b.onclick=()=>{state.cloudType=+b.dataset.cloud;const cp=CLOUDS[state.cloudType];$('#cloudLabel').textContent=cp.label+(state.cloudType?' '+cp.base+'–'+cp.top+' m':'');$$('[data-cloud]').forEach(x=>x.classList.toggle('active',x===b));state.lastInteraction=performance.now()-500});$('#demoToggle').onchange=e=>{state.demo=e.target.checked;state.demoAt=performance.now()+1200};$('#haze').oninput=e=>{state.haze=+e.target.value;$('#hazeText').textContent=state.haze<.38?'清透':state.haze>.70?'潮湿':'平衡'}}
async function init(){progress(.08,'编译地形与云层着色器');state.programs.surface=program(VS,FS);state.programs.mask=program(VS,MASKFS);state.programs.sky=program(SKYVS,SKYFS);progress(.16,'建立三维程序化云密度场');state.cloudNoise=makeCloudVolume();progress(.24,'解码温州全域概览');state.overview=await decode(DATA.overview);progress(.58,'解码洞头原生 12.5 米样板');state.detail=await decode(DATA.detail);progress(.78,'建立全域与近域网格');state.meshes.overview1=gridMesh(state.overview.width,state.overview.height,1);state.meshes.overview075=gridMesh(state.overview.width,state.overview.height,.75);state.meshes.detail4=gridMesh(state.detail.width,state.detail.height,4,[0,0,512,512]);state.meshes.detail2=gridMesh(state.detail.width,state.detail.height,2,[0,0,512,512]);state.meshes.detail1=gridMesh(state.detail.width,state.detail.height,1,[0,0,512,512]);state.meshes.inner1=state.meshes.detail1;state.ringOuter=patchBounds(state.detail,[0,0,512,512]);state.ringInner=patchBounds(state.detail,[32,64,480,512]);Object.assign(state,VIEWS.overview);state.ready=true;installControls();progress(1,'完成');setTimeout(()=>$('#loading').classList.add('hidden'),250);requestAnimationFrame(draw)}
init().catch(fatal);
</script>
</body></html>