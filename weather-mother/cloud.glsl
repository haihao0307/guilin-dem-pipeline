#version 300 es
precision highp float;precision highp sampler3D;
uniform vec2 uRes;uniform sampler3D uMacro,uOld,uNoise;
uniform vec3 uCamera,uTarget,uSun,uSunColor,uMoon,uWind,uMin,uMax,uLo[9],uHi[9];
uniform vec4 uOpt,uWeather,uEffects;uniform float uBlend,uTime,uDay,uExposure,uCloudBase,uCloudTop;uniform int uSteps,uGroups;out vec4 fragColor;
float sat(float v){return clamp(v,0.,1.);}vec3 sat3(vec3 v){return clamp(v,0.,1.);}
float hash(vec3 p){p=fract(p*.1031);p+=dot(p,p.yzx+33.33);return fract((p.x+p.y)*p.z);}
float nv(vec3 p){vec3 q=p*2.,i=floor(q),f=fract(q);f=f*f*(3.-2.*f);return texture(uNoise,(i+f+.5)/64.).r;}
float fb(vec3 p){return .57*nv(p)+.28*nv(p*2.03+11.7)+.15*nv(p*4.11-3.2);}
float mountain(vec2 p){if(uEffects.x<.5)return 0.;vec2 a=(p-vec2(-6.,-2.))/vec2(3.2,5.),b=(p-vec2(5.,-6.))/vec2(4.,3.),c=(p-vec2(0.,-9.))/vec2(6.,4.);return 1.15*exp(-dot(a,a))+1.4*exp(-dot(b,b))+.7*exp(-dot(c,c));}
vec3 planePos(){return vec3(mod(uTime*.33+10.,30.)-15.,3.8,-.4);}
float shape(vec3 p){vec3 uv=(p-uMin)/(uMax-uMin);if(any(lessThan(uv,vec3(0)))||any(greaterThan(uv,vec3(1))))return 0.;float b=texture(uMacro,uv).r;if(uBlend<.999)b=mix(texture(uOld,uv).r,b,uBlend);return b;}
vec3 flowPos(vec3 p){vec3 q=p-uWind;if(uEffects.x>.5){float h=mountain(p.xz),w=exp(-pow((p.y-h-1.1)/2.,2.));q.y-=h*w*.22*uWeather.w;q.x+=h*w*.09;}if(uEffects.y>.5){vec3 a=p-planePos();float wake=sat(-a.x/4.)*exp(min(a.x*.13,0.))*step(a.x,0.);q.yz+=vec2(-a.z,a.y)*wake*exp(-dot(a.yz,a.yz)*3.)*.55;}return q;}
float densityAt(vec3 p,bool detail){vec3 q=flowPos(p);float envelope=shape(q);if(envelope<.004)return 0.;if(!detail)return smoothstep(.16,.68,envelope)*uOpt.x*.72;vec3 ww=vec3(nv(q*1.5+7.),nv(q*1.6+vec3(19.,7.,31.)),nv(q*1.4+vec3(31.,13.,5.)))-.5;float b=shape(q+ww*(.5+.45*uOpt.y));if(b<.004)return 0.;vec3 v=q*2.5+vec3(uTime*.002,0.,uTime*.003);float n=fb(v),d=b+(fb(q*.9+13.)-.5)*.42-(.18+.22*(1.-n));float e=texture(uNoise,v*.37+vec3(.31,.57,.13)).g,f=nv(v*4.7);d-=(1.-e)*(.04+.09*uOpt.y)*(1.-sat(b*1.8));d+=(f-.5)*.035*uOpt.y;d=smoothstep(0.,.17,d)*(.55+.45*n)*uOpt.x;if(uEffects.y>.5){vec3 a=p-planePos();float wk=step(a.x,0.)*exp(min(a.x*.18,0.))*exp(-dot(a.yz,a.yz)*12.);d*=1.-wk*.42;}return d;}
vec2 bounds(vec3 ro,vec3 rd,vec3 lo,vec3 hi){vec3 d=mix(vec3(1.e-6),rd,greaterThan(abs(rd),vec3(1.e-6)));vec3 a=(lo-ro)/d,b=(hi-ro)/d,mn=min(a,b),mx=max(a,b);return vec2(max(mn.x,max(mn.y,mn.z)),min(mx.x,min(mx.y,mx.z)));}
float phaseHG(float g,float c){return (1.-g*g)/pow(max(1.+g*g-2.*g*c,.001),1.5);}
vec3 sky(vec3 rd){float h=max(rd.y,0.),sunUp=uSun.y,mu=dot(rd,uSun),tw=1.-smoothstep(.03,.38,sunUp);vec3 zen=mix(vec3(.0015,.003,.011),vec3(.025,.14,.46),uDay),hor=mix(vec3(.012,.021,.047),vec3(.30,.47,.70),uDay),col=mix(hor,zen,pow(h,.4));float toward=.35+.65*pow(max(mu,0.),3.);col+=vec3(.52,.13,.035)*tw*exp(-h*5.)*toward*smoothstep(-.16,.06,sunUp);col+=uSunColor*(phaseHG(.79,mu)*.009+pow(max(mu,0.),1400.)*6.)*smoothstep(-.07,.01,sunUp);col+=vec3(.54,.66,.91)*pow(max(dot(rd,uMoon),0.),2300.)*(1.-uDay)*1.6;float stars=pow(hash(floor(rd*700.)),240.)*smoothstep(.06,.45,h)*(1.-uDay);col+=vec3(stars)*.35;return max(col,vec3(.0001));}
float opticalDepth(vec3 p,vec3 sun){float tau=0.,travel=0.;for(int i=0;i<7;i++){float ds=.13*pow(1.55,float(i));tau+=densityAt(p+sun*(travel+ds*.5),false)*ds;travel+=ds;}return tau*2.5;}
vec3 incident(vec3 p,vec3 rd,float d){vec3 light=normalize(mix(uMoon,uSun,smoothstep(-.08,.01,uSun.y))+vec3(0.,.0001,0.));float tau=opticalDepth(p,light),mu=dot(rd,light),height=sat((p.y-uCloudBase)/max(uCloudTop-uCloudBase,.5)),ph=min(.82*phaseHG(.64,mu)+.18*phaseHG(-.22,mu),5.);float direct=exp(-tau),multiple=.24*exp(-tau*.24)+.08*exp(-tau*.065),ao=exp(-densityAt(p+vec3(0,.42,0),false)*.7-densityAt(p+vec3(0,1.1,0),false)*.9);vec3 ambient=mix(vec3(.04,.06,.10),vec3(.25,.36,.55),height)*(.32+.68*ao)*(.025+.975*uDay);vec3 lightColor=mix(vec3(.085,.115,.20),uSunColor,smoothstep(-.08,.01,uSun.y));float powder=.75+.25*(1.-exp(-d*4.));vec3 L=ambient+lightColor*(direct*(.30+.65*ph)+multiple*.65)*powder;L+=vec3(.055,.047,.033)*(1.-height)*uDay;float flash=uEffects.w*exp(-pow(fract(uTime*.12)-.25,2.)/.0001)*.8;L+=vec3(.5,.65,1.)*flash*exp(-dot(p-vec3(1.,4.,0.),p-vec3(1.,4.,0.))*.05);return L;}
float sceneGround(vec3 ro,vec3 rd){if(rd.y>=.001)return 1.e4;float t=max(0.,ro.y/-min(rd.y,-.001));if(uEffects.x<.5)return t;t=0.;for(int i=0;i<42;i++){vec3 p=ro+rd*t;float h=p.y-mountain(p.xz);if(h<.008)return t;t+=max(.035,h*.55);if(t>100.)break;}return 1.e4;}
float boxHit(vec3 ro,vec3 rd,vec3 ce,vec3 ra){vec2 t=bounds(ro-ce,rd,-ra,ra);return t.x<t.y&&t.y>0.?max(t.x,0.):1.e4;}
float airplane(vec3 ro,vec3 rd){if(uEffects.y<.5)return 1.e4;vec3 p=ro-planePos();float t=boxHit(p,rd,vec3(0),vec3(.40,.052,.055));t=min(t,boxHit(p,rd,vec3(-.03,0,0),vec3(.095,.018,.40)));t=min(t,boxHit(p,rd,vec3(-.30,.008,0),vec3(.065,.018,.16)));return min(t,boxHit(p,rd,vec3(-.29,.07,0),vec3(.064,.065,.014)));}
vec3 groundColor(vec3 ro,vec3 rd,float t){vec3 p=ro+rd*t;float n=nv(vec3(p.xz*.9,3.)),h=mountain(p.xz);vec3 normal=normalize(vec3(h-mountain(p.xz+vec2(.02,0)),.02,h-mountain(p.xz+vec2(0,.02))));vec3 gc=mix(vec3(.04,.068,.052),vec3(.09,.122,.075),n);gc=mix(gc,vec3(.75,.8,.85),uWeather.z*.85);float light=max(dot(normal,uSun),0.),shadow=0.;vec2 bb=bounds(p+vec3(0,.01,0),uSun,uMin+uWind,uMax+uWind);if(bb.y>max(bb.x,0.)){float ds=(bb.y-max(bb.x,0.))/10.;for(int i=0;i<10;i++)shadow+=densityAt(p+uSun*(max(bb.x,0.)+(float(i)+.5)*ds),false)*ds;}gc*=.22+.85*light*exp(-shadow*2.5);gc*=1.-uWeather.x*.32;vec3 halfv=normalize(uSun-rd);gc+=uSunColor*pow(max(dot(normal,halfv),0.),100.)*uWeather.x*.2;float haze=1.-exp(-t*(.018+uWeather.y*.06));return mix(gc*(.05+.95*uDay),sky(normalize(vec3(rd.x,.02,rd.z))),haze);}
vec3 bow(vec3 rd,float tr){if(uEffects.z<.5||uSun.y<0.||uSun.y>.72||uWeather.x<.05)return vec3(0);float a=acos(clamp(dot(rd,-uSun),-1.,1.));vec3 primary=exp(-pow((vec3(a)-radians(vec3(42.4,41.4,40.5)))/.009,vec3(2.)));vec3 secondary=exp(-pow((vec3(a)-radians(vec3(50.5,52.,53.5)))/.014,vec3(2.)))*.2;return (primary+secondary)*uWeather.x*.65*tr*smoothstep(-.01,.12,rd.y)*uDay;}
void main(){vec2 xy=(gl_FragCoord.xy*2.-uRes)/uRes.y;vec3 fw=normalize(uTarget-uCamera),right=normalize(cross(fw,vec3(0,1,0))),up=cross(right,fw),rd=normalize(fw+(right*xy.x+up*xy.y)*.48),ro=uCamera;float gt=sceneGround(ro,rd),pt=airplane(ro,rd),opaque=min(gt,pt);vec3 bg=gt<8000.?groundColor(ro,rd,gt):sky(rd);if(pt<gt)bg=mix(vec3(.018,.024,.03),vec3(.57,.63,.64)*uSunColor,.5)*(.05+.95*uDay);
vec2 seg[9];int ns=0;for(int k=0;k<9;k++){if(k>=uGroups)break;vec2 b=bounds(ro,rd,uLo[k]+uWind,uHi[k]+uWind);b=vec2(max(b.x,0.),min(b.y,opaque));if(b.y>b.x){seg[ns]=b;ns++;}}for(int k=1;k<9;k++){if(k>=ns)break;vec2 s=seg[k];int j=k-1;for(int z=0;z<9;z++){if(j<0)break;if(seg[j].x<=s.x)break;seg[j+1]=seg[j];j--;}seg[j+1]=s;}int nc=0;vec2 merged[9];for(int k=0;k<9;k++){if(k>=ns)break;if(nc==0){merged[0]=seg[k];nc=1;}else if(seg[k].x<=merged[nc-1].y)merged[nc-1].y=max(merged[nc-1].y,seg[k].y);else{merged[nc]=seg[k];nc++;}}float total=0.;for(int k=0;k<9;k++){if(k>=nc)break;total+=merged[k].y-merged[k].x;}float tr=1.;vec3 light=vec3(0);if(nc>0){float ds=total/float(uSteps),t=merged[0].x+ds*.5;int span=0;for(int j=0;j<200;j++){if(j>=uSteps||span>=nc||tr<.007)break;if(t>merged[span].y){float extra=t-merged[span].y;span++;if(span>=nc)break;t=merged[span].x+extra;}vec3 p=ro+rd*t;float d=densityAt(p,true);if(d>.001){float alpha=1.-exp(-d*ds*2.5);vec3 L=incident(p,rd,d);L=mix(L,sky(rd),1.-exp(-t*.010));light+=tr*alpha*L;tr*=1.-alpha;}t+=ds;}}
vec3 col=light+tr*bg+bow(rd,tr);if(uWeather.y>.07){float lengthFog=min(opaque,50.),k=rd.y/1.2,integral=abs(k)<.001?lengthFog:(1.-exp(clamp(-k*lengthFog,-30.,12.)))/k,tau=min(3.,uWeather.y*.08*exp(-ro.y/1.2)*integral);col=mix(col,sky(normalize(vec3(rd.x,.06,rd.z))),1.-exp(-tau));}
vec2 uv=gl_FragCoord.xy/uRes;float rain=0.;if(uWeather.x>.03){vec2 q=uv*vec2(210.,32.);q.x+=uTime*.65+q.y*.18;vec2 cell=floor(q),f=fract(q+vec2(0,uTime*13.));rain=pow(1.-abs(f.x-.5)*2.,22.)*(1.-smoothstep(.35,.97,f.y))*step(.56,hash(vec3(cell,12.)))*uWeather.x*.16;}if(uWeather.z>.05){vec2 q=uv*vec2(70.,40.)+vec2(sin(uTime*.3),uTime*1.6),cell=floor(q),f=fract(q)-.5;rain=(1.-smoothstep(.015,.09,length(f)))*step(.72,hash(vec3(cell,4.)))*uWeather.z*.35;}
col=mix(col,vec3(.8,.88,.96),rain);col=max(col*uExposure,vec3(0));col=(col*(2.51*col+.03))/(col*(2.43*col+.59)+.14);fragColor=vec4(pow(sat3(col),vec3(1./2.2)),tr);}
