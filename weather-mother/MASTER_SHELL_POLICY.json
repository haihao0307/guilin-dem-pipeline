{
  "productionLine": "Weather Mother",
  "version": "1.5.0",
  "effectiveDate": "2026-09-04",
  "root": "weather-mother/index.html",
  "defaultModule": "home",
  "persistentModules": [
    "world",
    "rain",
    "fog",
    "snow",
    "cloud",
    "storm"
  ],
  "requirements": {
    "rootAlwaysWeatherMother": true,
    "persistentSideNavigation": true,
    "sameDocumentModuleSwitching": true,
    "queryRouting": "?module=<id>",
    "iframeCount": 0,
    "returnPathAlwaysVisible": true,
    "moduleBrandingStaysInsideWeatherMother": true
  },
  "forbidden": [
    "root redirects to child module",
    "root iframe shell",
    "child module replaces Weather Mother identity",
    "missing return path",
    "empty fog route",
    "empty snow route"
  ],
  "visualApproved": false,
  "productionReady": false
}
