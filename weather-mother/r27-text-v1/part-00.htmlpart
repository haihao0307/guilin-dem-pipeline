<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#7896b6">
<title>Weather Mother · Cloud DNA Flight R27</title>
<style>
:root{color-scheme:dark;--glass:rgba(18,42,63,.74);--line:rgba(255,255,255,.16);--text:#f3f8fb;--muted:#c7d6df;--accent:#dceef8;--blue:#163d5a}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#6f88a8;color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",sans-serif}
canvas{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none;background:#6f88a8}
button,input,select{font:inherit}.hud{position:fixed;z-index:5;left:max(18px,env(safe-area-inset-left));top:max(18px,env(safe-area-inset-top));max-width:min(600px,calc(100vw - 370px));pointer-events:none;text-shadow:0 2px 16px rgba(15,34,52,.52)}
.eyebrow{font-size:10px;letter-spacing:.22em;text-transform:uppercase}.hud h1{font-size:clamp(24px,3.3vw,42px);line-height:1.02;letter-spacing:-.035em;margin:7px 0 7px}.hud p{margin:0;max-width:58ch;font-size:11px;line-height:1.55;color:#eff6fa}.badges{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.badge{padding:6px 9px;border:1px solid var(--line);border-radius:999px;background:rgba(16,40,61,.52);font-size:9px;backdrop-filter:blur(12px)}
.panel{position:fixed;z-index:7;right:max(12px,env(safe-area-inset-right));top:max(12px,env(safe-area-inset-top));width:330px;max-height:calc(100vh - 24px - env(safe-area-inset-bottom));overflow:auto;padding:12px;border:1px solid var(--line);border-radius:18px;background:var(--glass);box-shadow:0 24px 70px rgba(13,29,44,.30);backdrop-filter:blur(20px) saturate(1.12)}
.panel::-webkit-scrollbar{width:5px}.panel::-webkit-scrollbar-thumb{background:rgba(255,255,255,.24);border-radius:9px}.panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.panel-head strong{font-size:12px}.panel-head span{font-size:9px;color:#d2e2ea}.types{display:grid;grid-template-columns:repeat(2,1fr);gap:5px}.types button,.seg button,.actions button,.mobile-pad button,.mobile-toggle{border:1px solid rgba(255,255,255,.13);background:rgba(255,255,255,.055);color:#dbe8ee;border-radius:9px;cursor:pointer}.types button{padding:8px;text-align:left;min-height:42px}.types b{display:block;font-size:10px}.types span{display:block;margin-top:3px;font-size:8px;color:#b7cad4}.types button.on,.seg button.on,.actions button.on{background:rgba(224,242,251,.19);border-color:rgba(224,242,251,.58);color:white}.section{margin-top:10px;padding-top:10px;border-top:1px solid rgba(255,255,255,.10)}.section-title{display:flex;justify-content:space-between;gap:8px;margin-bottom:6px;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:#c5d6df}.row{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;padding:6px 0;border-top:1px solid rgba(255,255,255,.07)}.row:first-of-type{border-top:0}.lab{font-size:10px}.hint{display:block;margin-top:2px;font-size:8px;line-height:1.35;color:#b9cbd5}.val{font-size:9px;font-variant-numeric:tabular-nums}.row input[type=range]{grid-column:1/-1;width:100%;accent-color:#dff1fa}.seedbox{display:grid;grid-template-columns:1fr auto auto auto;gap:5px;align-items:center}.seedbox input{min-width:0;width:100%;padding:8px;border:1px solid rgba(255,255,255,.13);border-radius:8px;background:rgba(0,0,0,.16);color:white}.seedbox button{padding:8px 9px;border:1px solid rgba(255,255,255,.13);border-radius:8px;background:rgba(255,255,255,.055);color:white}.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.seg button{padding:8px 5px;font-size:9px}.actions{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-top:10px}.actions button{padding:9px 5px;font-size:9px}.note{margin-top:10px;padding:9px;border:1px solid rgba(255,255,255,.09);border-radius:10px;background:rgba(0,0,0,.13);font-size:8px;line-height:1.55;color:#c0d1da}.note b{color:white}.stats{position:fixed;z-index:5;left:max(14px,env(safe-area-inset-left));bottom:max(14px,env(safe-area-inset-bottom));display:flex;gap:6px;flex-wrap:wrap;max-width:70vw;pointer-events:none}.stat{padding:6px 8px;border:1px solid var(--line);border-radius:8px;background:rgba(16,40,61,.54);backdrop-filter:blur(10px);font-size:8px}.stat b{font-weight:650}.flightbar{position:fixed;z-index:6;left:50%;bottom:max(18px,env(safe-area-inset-bottom));transform:translateX(-50%);display:flex;gap:5px;padding:6px;border:1px solid var(--line);border-radius:999px;background:rgba(16,40,61,.72);backdrop-filter:blur(14px)}.flightbar button{border:0;border-radius:999px;background:transparent;color:white;padding:9px 13px;font-size:10px}.flightbar button.on{background:#e8f4fa;color:#183b55}.mobile-pad{display:none;position:fixed;z-index:7;left:14px;bottom:126px;grid-template-columns:repeat(3,48px);gap:7px}.mobile-pad button{width:48px;height:48px;border-radius:50%;font-size:18px;background:rgba(16,40,61,.78);backdrop-filter:blur(10px)}.mobile-toggle{display:none;position:fixed;z-index:8;right:12px;bottom:76px;padding:10px 13px;border-radius:999px;background:rgba(16,40,61,.78)}.crosshair{position:fixed;z-index:4;left:50%;top:50%;width:12px;height:12px;transform:translate(-50%,-50%);pointer-events:none;opacity:.58}.crosshair:before,.crosshair:after{content:"";position:absolute;background:#fff;box-shadow:0 0 8px rgba(20,48,70,.8)}.crosshair:before{left:5px;top:0;width:1px;height:12px}.crosshair:after{left:0;top:5px;width:12px;height:1px}.error{display:none;position:fixed;inset:0;z-index:30;place-items:center;background:#18354d;padding:24px}.error pre{white-space:pre-wrap;max-width:900px;color:#ffd0d0;font-size:11px}.loading{position:fixed;z-index:20;left:50%;top:50%;transform:translate(-50%,-50%);padding:12px 16px;border-radius:12px;background:rgba(16,40,61,.88);font-size:11px}.loading[hidden]{display:none}
@media(max-width:760px){.hud{left:14px;top:13px;max-width:calc(100vw - 28px)}.hud h1{font-size:23px;margin-top:6px}.hud p{max-width:34ch;font-size:9px}.badges .badge:nth-child(n+3){display:none}.panel{display:none;left:10px;right:10px;top:auto;bottom:68px;width:auto;max-height:72vh}.panel.open{display:block}.mobile-toggle{display:block}.mobile-pad{display:grid}.flightbar{left:12px;right:12px;transform:none;justify-content:center}.flightbar button{padding:9px 10px;font-size:9px}.stats{bottom:70px;max-width:220px}.crosshair{opacity:.42}}
</style>
</head>
<body>
<canvas id="cloudCanvas" aria-label="Weather Mother unified cloud object observation and flight world"></canvas>
<div class="hud"><div class="eyebrow">WEATHER MOTHER / CLOUD OBJECT DNA R27</div><h1 id="title">积云 · 同一云体观测与飞行</h1><p id="subtitle">同一份 CloudEnvelope、Density 与 Optics：观云与飞行只改变观察者，不替换云对象。</p><div class="badges"><span class="badge" id="objectId">WM-CU-73017</span><span class="badge" id="seedBadge">OBJECT 73017 · DETAIL 991</span><span class="badge" id="modeBadge">OBSERVE</span></div></div>
<div class="panel" id="panel"><div class="panel-head"><strong>Cloud DNA 控制台</strong><span>R27 / WebGL1-safe</span></div><div class="types" id="types"></div>
<div class="section"><div class="section-title"><span>观察者</span><span>同一世界</span></div><div class="seg" id="modeSeg"><button class="on" data-mode="observe">观云</button><button data-mode="flight">飞行</button><button data-mode="inspect">密度诊断</button></div></div>
<div class="section"><div class="section-title"><span>对象身份</span><span>可复现 Seed</span></div><div class="lab">Cloud Seed<span class="hint">决定大形、空洞、云瓣组合与实例身份</span></div><div class="seedbox"><input id="objectSeed" type="number" min="1" max="99999999" value="73017"><button data-seed="obj-prev">−</button><button data-seed="obj-next">＋</button><button data-seed="obj-rand">随机</button></div><div class="lab" style="margin-top:8px">Detail Seed<span class="hint">只改变局部侵蚀与高频，不改大轮廓</span></div><div class="seedbox"><input id="detailSeed" type="number" min="1" max="99999999" value="991"><button data-seed="det-prev">−</button><button data-seed="det-next">＋</button><button data-seed="det-rand">随机</button></div></div>
<div class="section"><div class="section-title"><span>云状态</span><span>与环境分开</span></div><div class="row"><div class="lab">覆盖率<span class="hint">厚区、薄区与明确空区</span></div><div class="val" id="coverV">0.48</div><input id="cover" type="range" min="0.28" max="0.70" step="0.01" value="0.48"></div><div class="row"><div class="lab">湿润边缘<span class="hint">低密度肩部，不是模糊滤镜</span></div><div class="val" id="wetV">0.80</div><input id="wet" type="range" min="0" max="1" step="0.01" value="0.80"></div><div class="row"><div class="lab">细节强度<span class="hint">高频尾部，可精确关闭</span></div><div class="val" id="detailV">0.62</div><input id="detail" type="range" min="0" max="1" step="0.01" value="0.62"></div><div class="row"><div class="lab">光学厚度<span class="hint">只影响消光与散射，不改密度</span></div><div class="val" id="extV">1.55</div><input id="ext" type="range" min="0.55" max="3.2" step="0.01" value="1.55"></div></div>
<div class="section"><div class="section-title"><span>环境驱动</span><span>不写入云身份</span></div><div class="row"><div class="lab">太阳方位</div><div class="val" id="sunAzV">25°</div><input id="sunAz" type="range" min="0" max="360" step="1" value="25"></div><div class="row"><div class="lab">太阳高度</div><div class="val" id="sunElV">28°</div><input id="sunEl" type="range" min="-4" max="85" step="1" value="28"></div><div cla