st.toggle('on',b.dataset.mode===ObserverState.mode));$('#observeBtn').classList.toggle('on',ObserverState.mode==='observe');$('#flightBtn').classList.toggle('on',ObserverState.mode==='flight');$('#autoBtn').classList.toggle('on',ObserverState.auto);$('#pause').textContent=WorldClock.playing?'暂停时间':'继续时间';$('#raySteps').textContent=RenderCache.steps;}
function setMode(m){ObserverState.mode=m;if(m==='flight'&&ObserverState.position[2]>10){ObserverState.position=[0,4.4,8.6];ObserverState.yaw=Math.PI;ObserverState.pitch=-.03;}syncUI();RenderCache.dirty=true;}
function resetObserver(){const t=TYPES[CloudState.type];ObserverState.orbitYaw=0;ObserverState.orbitPitch=.06;ObserverState.orbitRadius=t.cam[2];ObserverState.position=[0,4.4,8.6];ObserverState.yaw=Math.PI;ObserverState.pitch=-.03;ObserverState.auto=false;keys.clear();syncUI();RenderCache.dirty=true;}
function seedRandom(){return 1+Math.floor(Math.random()*99999998)}
function parseSeed(v,fallback){if(v===null||v===undefined||String(v).trim()==='')return fallback;const n=Math.floor(Number(v));return Number.isFinite(n)?clamp(n,1,99999999):fallback}
function setQuality(q){RenderCache.quality=q;const mobile=innerWidth<=760||matchMedia('(pointer:coarse)').matches;RenderCache.steps=q==='mobile'?(mobile?30:36):q==='high'?(mobile?52:64):(mobile?36:42);document.querySelectorAll('#qualitySeg button').forEach(b=>b.classList.toggle('on',b.dataset.quality===q));resize(true);syncUI();}
function buildUI(){const box=$('#types');TYPES.forEach((t,i)=>{const b=document.createElement('button');b.innerHTML='<b>'+t.cn+'</b><span>'+t.latin+'</span>';b.onclick=()=>applyType(i);box.appendChild(b);});document.querySelectorAll('#modeSeg button').forEach(b=>b.onclick=()=>setMode(b.dataset.mode));document.querySelectorAll('[data-seed]').forEach(b=>b.onclick=()=>{const k=b.dataset.seed;if(k==='obj-prev')CloudState.objectSeed=Math.max(1,CloudState.objectSeed-1);if(k==='obj-next')CloudState.objectSeed=Math.min(99999999,CloudState.objectSeed+1);if(k==='obj-rand')CloudState.objectSeed=seedRandom();if(k==='det-prev')CloudState.detailSeed=Math.max(1,CloudState.detailSeed-1);if(k==='det-next')CloudState.detailSeed=Math.min(99999999,CloudState.detailSeed+1);if(k==='det-rand')CloudState.detailSeed=seedRandom();syncUI();RenderCache.dirty=true;});$('#objectSeed').onchange=e=>{CloudState.objectSeed=parseSeed(e.target.value,CloudState.objectSeed);syncUI();RenderCache.dirty=true};$('#detailSeed').onchange=e=>{CloudState.detailSeed=parseSeed(e.target.value,CloudState.detailSeed);syncUI();RenderCache.dirty=true};[['cover','coverage'],['wet','wet'],['detail','detail'],['ext','ext']].forEach(([id,k])=>$('#'+id).oninput=e=>{CloudState[k]=Number(e.target.value);syncUI();RenderCache.dirty=true});$('#sunAz').oninput=e=>{EnvironmentDriver.sunAz=Number(e.target.value);syncUI();RenderCache.dirty=true};$('#sunEl').oninput=e=>{EnvironmentDriver.sunEl=Number(e.target.value);syncUI();RenderCache.dirty=true};$('#timeScale').oninput=e=>{WorldClock.scale=Number(e.target.value);syncUI()};document.querySelectorAll('#qualitySeg button').forEach(b=>b.onclick=()=>setQuality(b.dataset.quality));$('#pause').onclick=()=>{WorldClock.playing=!WorldClock.playing;syncUI();RenderCache.dirty=true};$('#reset').onclick=resetObserver;$('#resetBtn').onclick=resetObserver;$('#observeBtn').onclick=()=>setMode('observe');$('#flightBtn').onclick=()=>setMode('flight');$('#autoBtn').onclick=()=>{ObserverState.auto=!ObserverState.auto;setMode('flight');syncUI()};$('#mobileToggle').onclick=()=>$('#panel').classList.toggle('open');$('#copyLink').onclick=async()=>{const u=new URL(location.href);u.searchParams.set('type',TYPES[CloudState.type].code);u.searchParams.set('objectSeed',CloudState.objectSeed);u.searchParams.set('detailSeed',CloudState.detailSeed);u.searchParams.set('cover',CloudState.coverage.toFixed(2));u.searchParams.set('wet',CloudState.wet.toFixed(2));try{await navigator.clipboard.writeText(u.href);$('#copyLink').textContent='已复制';setTimeout(()=>$('#copyLink').textContent='复制参数',1200)}catch{location.hash=encodeURIComponent(u.search)}};syncUI();}
function loadQuery(){const q=new URLSearchParams(location.search),code=q.get('type');if(code){const i=TYPES.findIndex(t=>t.code===code.toUpperCase());if(i>=0)CloudState.type=i;}CloudState.objectSeed=parseSeed(q.get('objectSeed'),CloudState.objectSeed);CloudState.detailSeed=parseSeed(q.get('detailSeed'),CloudState.detailSeed);for(const [name,key,a,b] of [['cover','coverage',.28,.70],['wet','wet',0,1],['detail','detail',0,1]]){if(q.has(name))CloudState[key]=clamp(Number(q.get(name)),a,b);}if(q.get('mode')==='flight')ObserverState.mode='flight';}
canvas.addEventListener('pointerdown',e=>{pointer={id:e.pointerId,x:e.clientX,y:e.clientY};canvas.setPointerCapture(e.pointerId)});canvas.addEventListener('pointermove',e=>{if(!pointer||pointer.id!==e.pointerId)return;const dx=e.clientX-pointer.x,dy=e.clientY-pointer.y;pointer.x=e.clientX;pointer.y=e.clientY;if(ObserverState.mode==='observe'||ObserverState.mode==='inspect'){ObserverState.orbitYaw-=dx*.004;ObserverState.orbitPitch=clamp(ObserverState.orbitPitch+dy*.003,-.45,.65);}else{ObserverState.yaw-=dx*.004;ObserverState.pitch=clamp(ObserverState.pitch-dy*.003,-.72,.72);}RenderCache.dirty=true});['pointerup','pointercancel'].forEach(n=>canvas.addEventListener(n,e=>{if(pointer&&pointer.id===e.pointerId)pointer=null}));canvas.addEventListener('wheel',e=>{if(ObserverState.mode==='observe'||ObserverState.mode==='inspect'){ObserverState.orbitRadius=clamp(ObserverState.orbitRadius*Math.exp(e.deltaY*.001),5,34);RenderCache.dirty=true;e.preventDefault()}},{passive:false});window.addEventListener('keydown',e=>{const k=e.key.toLowerCase();if(['w','s','a','d','q','e'].includes(k)){keys.add(k);if(ObserverState.mode!=='flight')setMode('flight');e.preventDefault()}if(e.code==='Space'){WorldClock.playing=!WorldClock.playing;syncUI();e.preventDefault()}if(e.key==='Home'){resetObserver();e.preventDefault()}});window.addEventListener('keyup',e=>keys.delete(e.key.toLowerCase()));document.querySelectorAll('[data-key]').forEach(b=>{const k=b.dataset.key,down=e=>{e.preventDefault();keys.add(k);setMode('flight')},up=e=>{e.preventDefault();keys.delete(k)};b.addEventListener('pointerdown',down);['pointerup','pointercancel','pointerleave'].forEach(n=>b.addEventListener(n,up));});window.addEventListener('resize',()=>resize(true));canvas.addEventListener('webglcontextlost',e=>{e.preventDefault();lost=true;qa.errors.push('contextlost')});canvas.addEventListener('webglcontextrestored',()=>{lost=false;try{initGL()}catch(e){qa.errors.push(String(e))}});
const CloudQuery={coarseDensity(point,type=CloudState.type,objectSeed=CloudState.objectSeed){const [x,y,z]=point;const spacing=[12,17],cx=Math.floor((x+6)/12),cz=Math.floor((z+8.5)/17),seed=objectSeed+cx*37+cz*101;const r=(n)=>{const v=Math.sin(n*12.9898+seed*.013)*43758.5453;return v-Math.floor(v)};const ox=(r(1)-.5)*3,oy=3.5+(r(2)-.5)*1.2,oz=(r(3)-.5)*4.2;const q=[x-cx*12-ox,y-oy,z-cz*17-oz],ell=(c,s)=>Math.hypot((q[0]-c[0])/s[0],(q[1]-c[1])/s[1],(q[2]-c[2])/s[2]);let e=0;if(type===0)e=Math.max(0,1-Math.min(ell([-1.5,0,0],[2.8,1.2,1.8]),ell([.8,.5,0],[2.5,1.6,1.6])));else if(type===1)e=Math.max(0,1-Math.min(ell([0,0,0],[3.2,1.2,1.9]),ell([0,3,0],[1.9,3.3,1.4])));else e=Math.max(0,1-ell([0,.8,0],[5,type===7?.8:1.2,2.8]));return e;},sample(point){return this.coarseDensity(point)}};
function seedInvariantReport(){const pts=[];for(let z=-8;z<=8;z+=4)for(let x=-6;x<=6;x+=3)pts.push([x,3.8,z]);const a=pts.map(p=>CloudQuery.coarseDensity(p,CloudState.type,CloudState.objectSeed));const b=pts.map(p=>CloudQuery.coarseDensity(p,CloudState.type,CloudState.objectSeed));return{identical:a.every((v,i)=>v===b[i]),samples:a.length};}
window.WeatherR27={qa,EnvironmentDriver,WorldClock,CloudState,ObserverState,RenderCache,CloudQuery,setMode,setType:i=>applyType(i,false),setSeeds:(o,d)=>{CloudState.objectSeed=parseSeed(o,CloudState.objectSeed);CloudState.detailSeed=parseSeed(d,CloudState.detailSeed);syncUI();RenderCache.dirty=true},reset:resetObserver,seedInvariantReport,capture:()=>canvas.toDataURL()};
try{loadQuery();buildUI();initGL();applyType(CloudState.type,false);setQuality('auto');raf=requestAnimationFrame(tick)}catch(e){qa.errors.push(String(e));errorBox.style.display='grid';errText.textContent='R27 初始化失败：\n'+(e.stack||e);loading.hidden=true;}
})();
</script>
</body></html>