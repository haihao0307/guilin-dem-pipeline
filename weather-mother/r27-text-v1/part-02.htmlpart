ask+.50*e.y);rho-=e.z*max(-tail,0.)*(.28+.22*(1.-uWet));if(uType==7)rho=shoulder*(.12+.46*e.y+.18*macro)+tail*.12;if(uType==9)rho=shoulder*(.10+.24*e.y+.08*macro)+tail*.035;rho=max(0.,rho)*typeScale;return vec4(rho,e.x,macro+tail,e.z);}
vec3 sunDir(){float az=radians(uSunAz),el=radians(uSunEl);return normalize(vec3(sin(az)*cos(el),sin(el),-cos(az)*cos(el)));}
float phaseHG(float mu,float g){float g2=g*g;return (1.-g2)/(4.*PI*pow(max(1.+g2-2.*g*mu,.01),1.5));}
vec3 sky(vec3 rd,vec3 sun){float h=sat(rd.y*.52+.48);vec3 c=mix(vec3(.47,.61,.76),vec3(.13,.32,.53),pow(h,.62));float mu=max(dot(rd,sun),0.);c+=vec3(1.0,.73,.40)*pow(mu,420.)*4.8;c+=vec3(1.0,.62,.28)*pow(mu,18.)*.13;return c;}
float aircraftMask(vec2 p){p-=vec2(0.,-.27);p.x*=1.18;float fus=1.-smoothstep(.025,.055,abs(p.x))*(1.-smoothstep(.24,.34,abs(p.y)));float wings=1.-smoothstep(.025,.055,abs(p.y+.01))*(1.-smoothstep(.10,.34,abs(p.x)));float tail=1.-smoothstep(.018,.042,abs(p.y-.20))*(1.-smoothstep(.04,.14,abs(p.x)));return sat(max(fus,max(wings,tail)));}
void main(){vec2 sp=(gl_FragCoord.xy-.5*uRes)/uRes.y;vec3 rd=normalize(uFwd+sp.x*uRight*1.28+sp.y*uUp*1.28),ro=uCam,sun=sunDir();vec3 col=sky(rd,sun);float T=1.,Tplane=1.,t=.15,od=0.;float mu=max(dot(rd,sun),0.),phase=.70+8.0*phaseHG(mu,.68);float densView=0.,fieldView=0.;for(int i=0;i<72;i++){if(i>=uSteps||T<.015||t>54.)break;vec3 x=ro+rd*t;vec4 d=densityAt(x,t);if(d.x>.004){float l1=densityAt(x+sun*.82,t).x;float light=exp(-l1*uExt*.92);float a=1.-exp(-d.x*(t<14.?.34:.48)*uExt);float rim=d.w*sat(1.-d.x);float silver=pow(mu,10.)*rim*(1.2+2.8*light);vec3 shade=mix(vec3(.27,.35,.46),vec3(.94,.97,1.0),light*.80);shade+=vec3(1.0,.93,.78)*silver*1.8;col=mix(col,shade*phase,a*T);T*=1.-a;od+=d.x;densView=max(densView,d.x);fieldView=max(fieldView,d.z*.5+.5);}if(t<1.6)Tplane=T;t+=d.x>.015?.38:.92;}if(uInspect>.5){float g=uMode>.5?fieldView:densView;col=vec3(g);}else if(uMode>.5){float m=aircraftMask(sp);vec3 plane=mix(vec3(.16,.20,.24),vec3(.84,.90,.93),sat(-sp.y*2.));col=mix(col,plane,m*Tplane*.92);}col+=vec3(1.0,.88,.67)*pow(mu,30.)*.07*T;col=col/(col+vec3(.68));col=pow(col,vec3(.88));gl_FragColor=vec4(clamp(col,0.,1.),1.);}`;
function shader(type,src){const s=gl.createShader(type);gl.shaderSource(s,src);gl.compileShader(s);if(!gl.getShaderParameter(s,gl.COMPILE_STATUS))throw Error(gl.getShaderInfoLog(s));return s;}
function initGL(){gl=canvas.getContext('webgl',{alpha:false,antialias:false,depth:false,stencil:false,preserveDrawingBuffer:true,powerPreference:'high-performance'})||canvas.getContext('experimental-webgl');if(!gl)throw Error('此设备没有可用的 WebGL。');const vs=shader(gl.VERTEX_SHADER,VS),fs=shader(gl.FRAGMENT_SHADER,FS);program=gl.createProgram();gl.attachShader(program,vs);gl.attachShader(program,fs);gl.linkProgram(program);if(!gl.getProgramParameter(program,gl.LINK_STATUS))throw Error(gl.getProgramInfoLog(program));gl.deleteShader(vs);gl.deleteShader(fs);buffer=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,buffer);gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,3,-1,-1,3]),gl.STATIC_DRAW);const a=gl.getAttribLocation(program,'a');gl.enableVertexAttribArray(a);gl.vertexAttribPointer(a,2,gl.FLOAT,false,0,0);['uRes','uTime','uCover','uWet','uDetail','uExt','uSunAz','uSunEl','uObjSeed','uDetSeed','uMode','uInspect','uType','uSteps','uCam','uFwd','uRight','uUp'].forEach(n=>loc[n]=gl.getUniformLocation(program,n));qa.context='webgl1';resize(true);}
function cameraBasis(){if(ObserverState.mode==='observe'||ObserverState.mode==='inspect'){const cy=Math.cos(ObserverState.orbitYaw),sy=Math.sin(ObserverState.orbitYaw),cp=Math.cos(ObserverState.orbitPitch),sp=Math.sin(ObserverState.orbitPitch),r=ObserverState.orbitRadius;const pos=[ObserverState.target[0]+sy*cp*r,ObserverState.target[1]+sp*r,ObserverState.target[2]+cy*cp*r],f=norm(sub(ObserverState.target,pos)),right=norm(cross(f,[0,1,0])),up=norm(cross(right,f));return{pos,f,right,up};}const cy=Math.cos(ObserverState.yaw),sy=Math.sin(ObserverState.yaw),cp=Math.cos(ObserverState.pitch),sp=Math.sin(ObserverState.pitch),f=[sy*cp,sp,-cy*cp],right=[cy,0,sy],up=norm(cross(right,f));return{pos:ObserverState.position,f,right,up};}
function sub(a,b){return[a[0]-b[0],a[1]-b[1],a[2]-b[2]]}function cross(a,b){return[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]]}function norm(a){const l=Math.hypot(...a)||1;return a.map(v=>v/l)}
function resize(force=false){if(!gl)return;const mobile=innerWidth<=760||matchMedia('(pointer:coarse)').matches;let scale=RenderCache.quality==='mobile'?.46:RenderCache.quality==='high'?(mobile?.68:.86):(mobile?.56:.64);const d=Math.min(devicePixelRatio||1,mobile?1:1.35),cap=RenderCache.quality==='high'?(mobile?300000:950000):(mobile?220000:650000);let w=Math.max(1,Math.round(innerWidth*d*scale)),h=Math.max(1,Math.round(innerHeight*d*scale));const k=Math.min(1,Math.sqrt(cap/(w*h)));w=Math.max(1,Math.round(w*k));h=Math.max(1,Math.round(h*k));if(force||w!==canvas.width||h!==canvas.height){canvas.width=w;canvas.height=h;gl.viewport(0,0,w,h);qa.renderSize=[w,h];RenderCache.scale=w/innerWidth;RenderCache.dirty=true;$('#renderScale').textContent=RenderCache.scale.toFixed(2)+'×';}}
function updateUniforms(){const b=cameraBasis();gl.useProgram(program);gl.uniform2f(loc.uRes,canvas.width,canvas.height);gl.uniform1f(loc.uTime,WorldClock.time);gl.uniform1f(loc.uCover,CloudState.coverage);gl.uniform1f(loc.uWet,CloudState.wet);gl.uniform1f(loc.uDetail,CloudState.detail);gl.uniform1f(loc.uExt,CloudState.ext);gl.uniform1f(loc.uSunAz,EnvironmentDriver.sunAz);gl.uniform1f(loc.uSunEl,EnvironmentDriver.sunEl);gl.uniform1f(loc.uObjSeed,CloudState.objectSeed);gl.uniform1f(loc.uDetSeed,CloudState.detailSeed);gl.uniform1f(loc.uMode,ObserverState.mode==='flight'?1:0);gl.uniform1f(loc.uInspect,ObserverState.mode==='inspect'?1:0);gl.uniform1i(loc.uType,CloudState.type);gl.uniform1i(loc.uSteps,RenderCache.steps);gl.uniform3fv(loc.uCam,b.pos);gl.uniform3fv(loc.uFwd,b.f);gl.uniform3fv(loc.uRight,b.right);gl.uniform3fv(loc.uUp,b.up);}
function draw(){if(!gl||lost)return;updateUniforms();gl.drawArrays(gl.TRIANGLES,0,3);qa.frames++;RenderCache.dirty=false;if(!qa.ready&&qa.frames>=2){qa.ready=true;qa.startupMs=performance.now()-started;$('#startup').textContent=qa.startupMs.toFixed(0);loading.hidden=true;}}
function update(dt){if(WorldClock.playing){WorldClock.time+=dt*WorldClock.scale;RenderCache.dirty=true;}if(ObserverState.mode==='flight'){const turn=(keys.has('d')?1:0)-(keys.has('a')?1:0),climb=(keys.has('e')?1:0)-(keys.has('q')?1:0),throttle=(keys.has('w')?1:0)-(keys.has('s')?1:0);ObserverState.speed=clamp(ObserverState.speed+throttle*2.2*dt,0.6,8.0);ObserverState.yaw+=turn*.55*dt;ObserverState.pitch=clamp(ObserverState.pitch+climb*.38*dt,-.72,.72);ObserverState.roll+=(turn*.45-ObserverState.roll)*(1-Math.exp(-dt*4));if(ObserverState.auto||keys.size){const b=cameraBasis();for(let i=0;i<3;i++)ObserverState.position[i]+=b.f[i]*ObserverState.speed*dt;ObserverState.position[1]=clamp(ObserverState.position[1],.3,12);RenderCache.dirty=true;}}
}
function adapt(now){if(now-lastAdaptive<2200||RenderCache.quality!=='auto'||RenderCache.frameTimes.length<20)return;lastAdaptive=now;const a=RenderCache.frameTimes.slice(-20).reduce((x,y)=>x+y,0)/20;const mobile=innerWidth<=760||matchMedia('(pointer:coarse)').matches;if(a>43&&RenderCache.steps>(mobile?36:44)){RenderCache.steps-=6;resize(true);}else if(a<24&&RenderCache.steps<(mobile?52:68)){RenderCache.steps+=4;resize(true);}$('#raySteps').textContent=RenderCache.steps;}
function tick(now){raf=requestAnimationFrame(tick);const dt=clamp((now-last)/1000,0,.05);last=now;const t0=performance.now();update(dt);if(RenderCache.dirty||WorldClock.playing||ObserverState.mode==='flight')draw();const ft=performance.now()-t0;RenderCache.frameTimes.push(ft);if(RenderCache.frameTimes.length>120)RenderCache.frameTimes.shift();$('#frameMs').textContent=ft.toFixed(1);frameCounter++;if(now-fpsStamp>1000){RenderCache.fps=frameCounter*1000/(now-fpsStamp);frameCounter=0;fpsStamp=now;$('#fps').textContent=RenderCache.fps.toFixed(0);}adapt(now);}
function applyType(i,resetCamera=true){CloudState.type=(i+TYPES.length)%TYPES.length;const t=TYPES[CloudState.type];CloudState.coverage=t.cover;CloudState.wet=t.wet;CloudState.ext=t.ext;$('#cover').value=t.cover;$('#wet').value=t.wet;$('#ext').value=t.ext;if(resetCamera){ObserverState.target=[0,3.8,0];ObserverState.orbitRadius=t.cam[2];ObserverState.position=t.cam.slice();ObserverState.yaw=Math.PI;ObserverState.pitch=-.06;}syncUI();RenderCache.dirty=true;}
function syncUI(){const t=TYPES[CloudState.type];$('#title').textContent=t.cn+' · 同一云体观测与飞行';$('#objectId').textContent='WM-'+t.code+'-'+CloudState.objectSeed;$('#seedBadge').textContent='OBJECT '+CloudState.objectSeed+' · DETAIL '+CloudState.detailSeed;$('#modeBadge').textContent=ObserverState.mode.toUpperCase();$('#coverV').textContent=CloudState.coverage.toFixed(2);$('#wetV').textContent=CloudState.wet.toFixed(2);$('#detailV').textContent=CloudState.detail.toFixed(2);$('#extV').textContent=CloudState.ext.toFixed(2);$('#sunAzV').textContent=Math.round(EnvironmentDriver.sunAz)+'°';$('#sunElV').textContent=Math.round(EnvironmentDriver.sunEl)+'°';$('#timeScaleV').textContent=WorldClock.scale.toFixed(2)+'×';$('#objectSeed').value=CloudState.objectSeed;$('#detailSeed').value=CloudState.detailSeed;document.querySelectorAll('#types button').forEach((b,i)=>b.classList.toggle('on',i===CloudState.type));document.querySelectorAll('#modeSeg button').forEach(b=>b.classLi