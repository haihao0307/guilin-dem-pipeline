      "Karst_SlopeMask",
      "Vegetation_SlopeMask",
      "DeterministicSeed"
    ],
    "profiles": ["Preview_1K", "Review_4K", "Tiles_Final"],
    "seed": 1337,
    "deterministic": true
  },
  "visualizationRecipe": {
    "name": "guilin-erosion-karst-vegetation-v1",
    "input": "DEM_Input",
    "stages": [
      {"node": "Erosion2", "role": "broad restrained macro drainage", "mix": 0.12, "authoritative": false},
      {"node": "Erosion2", "role": "fine restrained detail", "mix": 0.08, "authoritative": false},
      {"node": "Thermal2", "role": "masked talus on steep slopes", "mask": "Karst_SlopeMask", "authoritative": false},
      {"node": "Outcrops", "role": "karst rock support/material mask", "mask": "Karst_SlopeMask", "authoritative": false},
      {"node": "Height/Slope/Curvature/FlowMap/Normals", "role": "linear web material maps", "authoritative": false},
      {"node": "Vegetation masks", "role": "ecology package placement", "mask": "Vegetation_SlopeMask", "authoritative": false}
    ],
    "preserveBlend": {"original": "DEM_Input", "processed": "VisualizationBranch", "ratioVariable": "ProcessMix", "sourceOfTruth": "original"}
