  "equations": [
    {
      "id": "normalized_social_turn",
      "evidenceClass": "ENGINEERING_CANDIDATE",
      "formula": "omegaSocial=kAlign*sum(W*V*B*sin(deltaHeading))/(epsilon+sum(W*V*B))+kAttract*sum(W*V*A*sin(bearing))/(epsilon+sum(W*V))",
      "units": "rad/s",
      "note": "Own bounded kernels and normalization; no hard geometry replacement"
    },
    {
      "id": "angular_response",
      "evidenceClass": "ENGINEERING_CANDIDATE",
      "formula": "omegaNext=omegaTarget+(omega-omegaTarget)*exp(-dt/tauTurn); constrain abs(deltaOmega)<=alphaYaw*dt; thetaNext=wrap(theta+omegaNext*dt)",
      "units": "seconds,radians,rad/s,rad/s^2",
      "note": "Check committed yaw/pitch/roll after every safety guard, not target only"
    },
    {
      "id": "speed_response",
      "evidenceClass": "ENGINEERING_CANDIDATE",
      "formula": "acceleration=clamp((uTarget-u)/tauSpeed,-aBrake,aThrust); uNext=max(0,u+acceleration*dt); v=sourceLength*uNext*acceptedHeading",
      "units": "BL/s,BL/s^2",
      "note": "Separate propulsion demand from accepted translation and gait observables"
    },
    {
      "id": "bounded_distance_kernels",
      "evidenceClass": "ENGINEERING_CANDIDATE",
      "formula": "A(q)=tanh((q-q0)/sGap)/(1+(q/lAttract)^2); B(q)=1/(1+(q/lAlign)^2); W=1-quintic(clamp((q-rFull)/(rSight-rFull),0,1))",
      "units": "dimensionless q=d/Lpair and kernels",
      "note": "Not literal fitted Calovi equations; q0 derived from source support"
    },
    {
      "id": "predictive_safety",
      "evidenceClass": "ENGINEERING_CANDIDATE",
      "formula": "tCPA=clamp(-dot(r,vRelative)/(dot(vRelative,vRelative)+epsilon),0,predictSeconds); rCPA=r+tCPA*vRelative",
      "units": "world length,seconds,world length/s",
      "note": "Constant-velocity CPA needs separate full-source rotation/gait-sweep support and head-on tiebreak"
    },
    {
      "id": "stopping_feasibility",
      "evidenceClass": "ENGINEERING_CANDIDATE",
      "formula": "closingSpeed^2/(2*reachableRelativeBrake)+closingSpeed*tauResponse <= surfaceClearance-rotationSweepReserve",
      "units": "all lengths same world units",
      "note": "Necessary viability condition, not complete collision guarantee. Impossible initial state cannot satisfy hard safety plus bounded acceleration by instant velocity scaling"
    },
    {
      "id": "correlated_noise",
      "evidenceClass": "ENGINEERING_CANDIDATE",
      "formula": "rho=exp(-dt/tauNoise); etaNext=rho*eta+sigmaOmega*sqrt(1-rho^2)*Normal(0,1)",
      "units": "sigmaOmega stationary rad/s; tauNoise seconds",
      "note": "Distinct from SDE diffusion sigma rad/s^(3/2); post-limit process not exact OU"
    }
  ],
