  "documented_facts": [
    {
      "fact_id": "rice.typical_grass_architecture",
      "claim": "Cultivated rice is a grass with a fibrous root system, erect culms, long flat leaves, and multiple tillers; a tiller consists of a culm and leaves and may or may not bear a panicle.",
      "source_id": "AU_OGTR_RICE_BIOLOGY_2005_2021",
      "locator": "Section 1.3, PDF pp. 10-11 (document pages 9-10)",
      "kind": "documented",
      "applicable_scope": "species-level organ inventory; dimensions and cultivar form are not supplied"
    },
    {
      "fact_id": "rice.tiller_hierarchy",
      "claim": "Primary tillers arise from nodes near the base of the main culm; secondary and tertiary tillers arise sequentially from them.",
      "source_id": "AU_OGTR_RICE_BIOLOGY_2005_2021",
      "locator": "Section 1.3, document p. 9; Section 1.4.1, document p. 10",
      "kind": "documented",
      "applicable_scope": "categorical branching relation, not a tiller count"
    },
    {
      "fact_id": "rice.leaf_anatomy",
      "claim": "Rice leaves alternate on the culm and include a sheath enclosing the culm, a flat blade, a collar, a ligule, and auricles.",
      "source_id": "AU_OGTR_RICE_BIOLOGY_2005_2021",
      "locator": "Section 1.3, document pp. 9-10",
      "kind": "documented",
      "applicable_scope": "species-level component topology; size, color, and pubescence vary"
    },
    {
      "fact_id": "rice.panicle_spikelet_floret",
      "claim": "The panicle emerges from the flag-leaf sheath; its rachis and branches bear spikelets, each with a floret, and at anthesis the floret opens as the stamens elongate and emerge.",
      "source_id": "AU_OGTR_RICE_BIOLOGY_2005_2021",
      "locator": "Section 1.3, document p. 10",
      "kind": "documented",
      "applicable_scope": "species-level reproductive organ relations, not regional panicle dimensions"
    },
    {
      "fact_id": "rice.vegetative_growth",
      "claim": "Fibrous roots develop from underground nodes, the primary leaf emerges, tillers develop from lower leaf axils, and internodes begin to elongate at or near panicle initiation.",
      "source_id": "AU_OGTR_RICE_BIOLOGY_2005_2021",
      "locator": "Section 1.4.1, document p. 10",
      "kind": "documented",
      "applicable_scope": "developmental sequence; timing and dimensions are not regional defaults"
    },
    {
      "fact_id": "rice.panicle_initiation_and_boot",
      "claim": "Reproductive development begins with panicle initiation at the growing tip of a tiller, after which the panicle grows inside the flag-leaf sheath before heading.",
      "source_id": "AU_OGTR_RICE_BIOLOGY_2005_2021",
      "locator": "Section 1.4.2, document p. 10",
      "kind": "documented",
      "applicable_scope": "categorical hidden-panicle transition"
    },
    {
      "fact_id": "rice.heading_and_flowering",
      "claim": "Heading is panicle emergence and may be partial or full; flowering follows, with florets opening and stamens elongating.",
      "source_id": "AU_OGTR_RICE_BIOLOGY_2005_2021",
      "locator": "Section 1.4.2, document pp. 10-11",
      "kind": "documented",
      "applicable_scope": "event order and visible organ change; no regional dates or percentages"
    },
    {
      "fact_id": "rice.grain_ripening",
      "claim": "After fertilization, ovaries develop into grain that passes through milky and dough states; the panicle bends, senescence advances, and mature grain becomes hard and dry as the plant yellows and dries.",
      "source_id": "AU_OGTR_RICE_BIOLOGY_2005_2021",
      "locator": "Section 1.4.3, document p. 11",
      "kind": "documented",
      "applicable_scope": "categorical ripening structure and posture; no regional calendar or color values"
    },
    {
      "fact_id": "rice.cultivar_variability",
      "claim": "Rice cultivars vary in height, tiller number and form, and leaf, panicle, hull, and grain shape, size, and color.",
      "source_id": "AU_OGTR_RICE_BIOLOGY_2005_2021",
      "locator": "Sections 1.2.2 and 1.3, document pp. 8-10",
      "kind": "documented",
      "applicable_scope": "constraint against one universal numeric or visual rice model"
    },
    {
      "fact_id": "honghe.red_rice_diversity",
      "claim": "The Honghe evaluation reports many local red-rice varieties and says farmers vary varieties and methods with altitude and local conditions.",
      "source_id": "UNESCO_ICOMOS_HONGHE_2013",
      "locator": "ICOMOS Advisory Body Evaluation No. 1111, p. 76",
      "kind": "documented",
      "applicable_scope": "regional diversity constraint; it does not supply organ dimensions for a single reference cultivar"
    }
  ],
