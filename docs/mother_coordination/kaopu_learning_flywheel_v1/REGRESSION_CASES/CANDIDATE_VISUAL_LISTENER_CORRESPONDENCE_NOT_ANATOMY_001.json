      "boundaryDefined=true",
      "crossViewStable=true OR temporalStable=true",
      "anatomicalOrGeometricSupport=true",
      "at least two independentEvidenceRoots",
      "when requireBoundEvidenceRoots=true, at least two distinct roots directly bind the same subjectId and every requiredClaimId",
      "relationInvariantsDefined=true",
      "conflict=false"
    ],
    "correspondenceOnlyDecision": "OBSERVATION_CORRESPONDENCE_CANDIDATE",
    "uncertainDecision": "OBSERVATION_UNCERTAIN_NOT_ANCHOR",
    "conflictDecision": "HOLD_OBSERVATION_CONFLICT"
