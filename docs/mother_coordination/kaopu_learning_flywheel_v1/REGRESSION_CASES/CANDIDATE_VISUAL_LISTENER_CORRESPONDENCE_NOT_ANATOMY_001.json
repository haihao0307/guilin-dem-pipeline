  "failure": {
    "summary": "Dense visual similarity, segmentation, tracking or surface correspondence can be mistakenly promoted into anatomical identity or a stable Grammar Anchor without independent structural evidence.",
    "observedRisk": [
      "DINOv3 patch similarity can be spatially coherent without proving anatomy",
      "SAM2 mask continuity can preserve an object or part mask without proving left/right or joint identity",
      "DensePose/CSE correspondence can map pixels to template geometry while remaining a correspondence claim",
      "occlusion can be mistaken for absence when persistent part identity is not anchored"
    ]
  },
  "mustNeverRepeat": [
    "promote DINO/SAM/CSE output alone to anatomical truth",
    "treat occluded or unresolved part as absent",
    "merge contradictory left/right or part identities into one anchor",
    "promote an anchor without declared uncertainty and evidence roots"
  ],
  "gate": {
