{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haihao0307.github.io/guilin-dem-pipeline/schemas/dem-procedural-landscape/branch-registry-v2.schema.json",
  "title": "DEM Procedural Landscape Branch Registry v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "skill",
    "governance",
    "referenceBranches",
    "activeBranches",
    "globalRules"
  ],
  "properties": {
    "schema": {
      "const": "dem_procedural_landscape_branch_registry@2.0.0"
    },
    "skill": {
      "type": "object",
      "required": [
        "id",
        "version",
        "repository",
        "branch",
        "status",
        "controllerAlias"
      ],
      "properties": {
        "id": {
          "const": "dem-procedural-landscape"
        },
        "version": {
          "const": "0.2.0"
        },
        "repository": {
          "const": "haihao0307/guilin-dem-pipeline"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "draftPr": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "controllerAlias": {
          "const": "小王"
        }
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "doctrinePath",
        "userVisualApprovalRequired",
        "githubIsAuthoritativeBridge",
        "codexIsDownstreamExecutor",
        "truthLayersReadOnly",
        "failClosed"
      ],
      "properties": {
        "doctrinePath": {
          "type": "string",
          "minLength": 1
        },
        "userVisualApprovalRequired": {
          "const": true
        },
        "githubIsAuthoritativeBridge": {
          "const": true
        },
        "codexIsDownstreamExecutor": {
          "const": true
        },
        "truthLayersReadOnly": {
          "const": true
        },
        "failClosed": {
          "const": true
        }
      }
    },
    "referenceBranches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/branch"
      }
    },
    "activeBranches": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/branch"
      }
    },
    "globalRules": {
      "type": "object",
      "required": [
        "defaultOutputGridM",
        "no30mFinalFallback",
        "noSyntheticGapFill",
        "noTruthOverwrite",
        "proceduralFieldsRequireParentMask",
        "historicalLayersSeparate",
        "visualLayersSeparate",
        "verticalScale",
        "controllerVisualApprovalRequired",
        "browserQaRequired",
        "rollbackRequired"
      ],
      "properties": {
        "defaultOutputGridM": {
          "const": 12.5
        },
        "no30mFinalFallback": {
          "const": true
        },
        "noSyntheticGapFill": {
          "const": true
        },
        "noTruthOverwrite": {
          "const": true
        },
        "proceduralFieldsRequireParentMask": {
          "const": true
        },
        "historicalLayersSeparate": {
          "const": true
        },
        "visualLayersSeparate": {
          "const": true
        },
        "verticalScale": {
          "const": "1:1"
        },
        "controllerVisualApprovalRequired": {
          "const": true
        },
        "browserQaRequired": {
          "const": true
        },
        "rollbackRequired": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "branch": {
      "type": "object",
      "required": [
        "id",
        "nameZh",
        "skillPath",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$"
        },
        "nameZh": {
          "type": "string",
          "minLength": 1
        },
        "skillPath": {
          "type": "string",
          "pattern": "^skills/dem-procedural-landscape/branches/.+/SKILL\\.md$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
