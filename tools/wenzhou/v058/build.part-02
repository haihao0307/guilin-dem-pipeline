#identity b{{display:block;font-size:14px;letter-spacing:.08em;font-weight:680;text-shadow:0 1px 8px rgba(14,35,48,.28)}}
#identity span{{display:block;margin-top:3px;font-size:10px;letter-spacing:.04em;color:rgba(245,252,255,.82)}}
#quality{{right:calc(var(--safe-r) + 60px);top:calc(var(--safe-t) + 2px);padding:7px 10px;border-radius:15px;font-size:10px;color:rgba(247,252,255,.88);opacity:0;transform:translateY(-6px);transition:opacity .25s,transform .25s}}
#quality.show{{opacity:.92;transform:none}}
#menuBtn{{pointer-events:auto;right:var(--safe-r);top:var(--safe-t);width:48px;height:48px;border-radius:24px;display:grid;place-items:center;border:0;color:#fff;cursor:pointer;transition:width .55s cubic-bezier(.22,.9,.2,1),height .55s cubic-bezier(.22,.9,.2,1),border-radius .55s cubic-bezier(.22,.9,.2,1),transform .22s}}
#menuBtn:active{{transform:scale(.94)}}
#menuBtn i,#menuBtn i::before,#menuBtn i::after{{display:block;width:18px;height:1.5px;background:rgba(255,255,255,.96);border-radius:2px;content:"";transition:transform .35s,opacity .25s}}
#menuBtn i::before{{transform:translateY(-5px)}}#menuBtn i::after{{transform:translateY(3.5px)}}
#menuBtn.open i{{background:transparent}}#menuBtn.open i::before{{transform:translateY(0) rotate(45deg)}}#menuBtn.open i::after{{transform:translateY(-1.5px) rotate(-45deg)}}
#panel{{pointer-events:auto;right:var(--safe-r);top:calc(var(--safe-t) + 58px);width:min(328px,calc(100vw - var(--safe-l) - var(--safe-r)));max-height:min(72vh,560px);padding:14px;border-radius:27px;opacity:0;transform:translate3d(12px,-22px,0) scale(.68);transform-origin:92% 0;clip-path:circle(3% at 92% 0);transition:opacity .28s,transform .58s cubic-bezier(.18,.9,.18,1),clip-path .58s cubic-bezier(.18,.9,.18,1);overflow:auto;overscroll-behavior:contain}}
#panel.open{{opacity:1;transform:none;clip-path:circle(145% at 92% 0)}}
.panelTitle{{font-size:12px;letter-spacing:.08em;font-weight:680;margin:2px 2px 10px;color:rgba(255,255,255,.95)}}
.group{{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-bottom:12px}}
.group button{{appearance:none;border:1px solid rgba(255,255,255,.26);background:rgba(16,55,76,.22);color:rgba(255,255,255,.92);min-height:42px;border-radius:15px;padding:8px 9px;font-size:12px;text-align:left;cursor:pointer;transition:transform .18s,background .25s,border-color .25s}}
.group button:active{{transform:scale(.96)}}.group button.active{{background:rgba(225,246,255,.23);border-color:rgba(255,255,255,.58)}}
.readout{{display:grid;grid-template-columns:1fr auto;gap:5px 12px;padding:9px 10px;border-radius:15px;background:rgba(6,35,51,.18);font-size:10px;line-height:1.45;color:rgba(240,249,253,.78)}}
.readout strong{{font-weight:620;color:#fff}}
#hint{{left:50%;bottom:var(--safe-b);transform:translateX(-50%);padding:8px 13px;border-radius:17px;font-size:10px;white-space:nowrap;opacity:.76;transition:opacity .5s}}
#hint.hide{{opacity:0}}
#loading{{inset:0;display:grid;place-items:center;background:linear-gradient(#8fb8d0,#d5e6df);z-index:50;transition:opacity .75s;pointer-events:auto}}
#loading.done{{opacity:0;pointer-events:none}}
.loader{{width:min(340px,82vw);padding:22px 24px;border-radius:28px;text-align:center;color:#f8fdff}}
.loader b{{display:block;font-size:18px;letter-spacing:.08em;margin-bottom:8px}}.loader small{{font-size:11px;color:rgba(255,255,255,.78)}}
.progress{{height:3px;background:rgba(255,255,255,.17);border-radius:3px;margin-top:16px;overflow:hidden}}.progress i{{display:block;width:8%;height:100%;background:rgba(255,255,255,.88);border-radius:3px;transition:width .4s}}
@media(max-width:620px){{#identity{{min-width:0;padding:8px 11px;border-radius:16px}}#identity b{{font-size:12px}}#identity span{{font-size:9px}}#menuBtn{{width:44px;height:44px}}#panel{{top:calc(var(--safe-t) + 53px);max-height:73vh}}#hint{{font-size:9px;max-width:86vw;overflow:hidden;text-overflow:ellipsis}}}}
@media(prefers-reduced-motion:reduce){{*{{animation:none!important;transition-duration:.01ms!important}}}}
</style>
<script type="importmap">{{"imports":{{"three":"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js","three/addons/":"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"}}}}</script>
</head>
<body>
<div id="app"><canvas id="world" aria-label="温州连续三维世界"></canvas></div>
<div id="loading" class="ui"><div class="loader glass"><b>小温州 · 连续世界</b><small id="loadText">正在展开全温州数字地貌</small><div class="progress"><i id="loadBar"></i></div></div></div>
<div id="identity" class="ui glass"><b>温州连续世界 V0.5.8</b><span id="identitySub">全域关系持续可见 · 近景自动精化</span></div>
<div id="quality" class="ui glass">2048 近景收敛</div>
<button id="menuBtn" class="ui glass" aria-label="打开菜单"><i></i></button>
<section id="panel" class="ui glass" aria-hidden="true">
  <div class="panelTitle">观察路径</div>
  <div class="group" id="views">
    <button data-view="all" class="active">整个温州<br><small>完整地理关系</small></button>
    <button data-view="approach">洞头接近<br><small>全景连续拉近</small></button>
    <button data-view="flight">1200 米飞行<br><small>近域原生细节</small></button>
    <button data-view="coast">海岸低空<br><small>近景观察</small></button>
  </div>
  <div class="panelTitle">世界状态</div>
  <div class="group" id="worldModes">
    <button data-cloud="mixed" class="active">多层云系</button>
    <button data-cloud="clear">晴空少云</button>
    <button data-time="morning">清晨光照</button>
    <button data-time="noon" class="active">正午光照</button>
  </div>
  <div class="readout">
    <span>全域高程</span><strong>{rows} × {cols}</strong>
    <span>全域采样</span><strong>{spacing:.0f} m</strong>
    <span>洞头近域</span><strong>513 × 513</strong>
    <span>近域采样</span><strong>12.5 m</strong>
    <span>稳定画幅</span><strong id="bufferRead">计算中</strong>
    <span>当前观察</span><strong id="viewRead">整个温州</strong>
  </div>
</section>
<div id="hint" class="ui glass">单指旋转 · 双指缩放和平移 · 双击地面聚焦</div>
<script type="module">
import * as THREE from 'three';
import {{ OrbitControls }} from 'three/addons/controls/OrbitControls.js';

const DATA={{
  overview:{{rows:{rows},cols:{cols},spacing:{spacing},min:{min(over_vals)},max:{max(over_vals)},b64:'{over_b64}'}},
  marine:{{b64:'{marine_b64}'}},
  detail:{{rows:513,cols:513,spacing:12.5,min:{detail_min},max:{detail_max},center:[{detail_cx:.6f},{detail_cz:.6f}],lon:{detail_lon},lat:{detail_lat},b64:'{detail_b64}'}},
  world:{{width:{world_w:.6f},depth:{world_d:.6f},wgs:[{','.join(str(v) for v in wgs)}]}}
}};

const $=s=>document.querySelector(s);
const canvas=$('#world'), loading=$('#loading'), loadText=$('#loadText'), loadBar=$('#loadBar');
function progress(p,t){{loadBar.style.width=Math.round(p*100)+'%'; if(t)loadText.textContent=t;}}
async function gunzipB64(s){{
  const raw=Uint8Array.from(atob(s),c=>c.charCodeAt(0));
  if('DecompressionStream' in window){{const ds=new DecompressionStream('gzip');return new Uint8Array(await new Response(new Blob([raw]).stream().pipeThrough(ds)).arrayBuffer());}}
  throw new Error('浏览器缺少 gzip 解码能力');
}}
function i16(bytes){{return new Int16Array(bytes.buffer,bytes.byteOffset,bytes.byteLength/2)}}
function clamp(x,a,b){{return Math.max(a,Math.min(b,x))}}
function smooth(a,b,x){{x=clamp((x-a)/(b-a),0,1);return x*x*(3-2*x)}}
function hash2(x,z){{return (Math.sin(x*0.000781+z*0.001173)*43758.5453)%1}}

progress(.12,'读取全温州连续高程');
const [overviewBytes,marineBytes,detailBytes]=await Promise.all([gunzipB64(DATA.overview.b64),gunzipB64(DATA.marine.b64),gunzipB64(DATA.detail.b64)]);
const overview=i16(overviewBytes), marine=marineBytes, detail=i16(detailBytes);
progress(.34,'建立统一世界坐标');

const renderer=new THREE.WebGLRenderer({{canvas,antialias:false,alpha:false,powerPreference:'high-performance',precision:'highp'}});
renderer.outputColorSpace=THREE.SRGBColorSpace;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=1.02;
renderer.setClearColor(0xa9cbdc,1);
const scene=new THREE.Scene();
scene.fog=new THREE.FogExp2(0xb8d2dc,0.0000082);
const camera=new THREE.PerspectiveCamera(43,1,4,520000);
const controls=new OrbitControls(camera,canvas);
controls.enableDamping=true; controls.dampingFactor=.065; controls.screenSpacePanning=true;
controls.minDistance=120; controls.maxDistance=390000; controls.maxPolarAngle=Math.PI*.485;
controls.zoomToCursor=true; controls.target.set(0,100,0);

const WORLD={{state:{{time:'noon',cloud:'mixed',wind:[7.2,2.4]}},view:{{mode:'all',moving:false,settled:true}},presentation:{{targetLong:2048,frameCap:30}}}};

function sampleOverview(wx,wz){{
  const fx=(wx/DATA.world.width+.5)*(DATA.overview.cols-1);
  const fz=(wz/DATA.world.depth+.5)*(DATA.overview.rows-1);
  const x0=clamp(Math.floor(fx),0,DATA.overview.cols-1), z0=clamp(Math.floor(fz),0,DATA.overview.rows-1);
  const x1=Math.min(DATA.overview.cols-1,x0+1), z1=Math.min(DATA.overview.rows-1,z0+1);
  const tx=clamp(fx-x0,0,1),tz=clamp(fz-z0,0,1);
  const a=overview[z0*DATA.overview.cols+x0],b=overview[z0*DATA.overview.cols+x1],c=overview[z1*DATA.overview.cols+x0],d=overview[z1*DATA.overview.cols+x1];
  return THREE.MathUtils.lerp(THREE.MathUtils.lerp(a,b,tx),THREE.MathUtils.lerp(c,d,tx),tz);
}}

const terrainVertex=`
  varying vec3 vWorld; varying vec3 vN; varying float vFeather;
  attribute float feather;
  void main(){vWorld=(modelMatrix*vec4(position,1.)).xyz;vN=normalize(mat3(modelMatrix)*normal);vFeather=feather;gl_Position=projectionMatrix*viewMatrix*vec4(vWorld,1.);}`;
const terrainFragment=`
  precision highp float; varying vec3 vWorld; varying vec3 vN; varying float vFeather;
