<style>
:root{{--glass-x:50%;--glass-y:20%;--glass-flow:0deg;--safe-t:max(12px,env(safe-area-inset-top));--safe-r:max(12px,env(safe-area-inset-right));--safe-b:max(12px,env(safe-area-inset-bottom));--safe-l:max(12px,env(safe-area-inset-left));}}
