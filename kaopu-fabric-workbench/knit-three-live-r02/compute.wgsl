// KAOPU Knit Live R02. Source-derived compute experiment, not the unchanged engine player.
struct Params {
 eye:vec4<f32>, forward:vec4<f32>, right:vec4<f32>, up:vec4<f32>, profile:vec4<f32>,
 lightEye0:vec4<f32>, lightF0:vec4<f32>, lightR0:vec4<f32>, lightU0:vec4<f32>,
 lightEye1:vec4<f32>, lightF1:vec4<f32>, lightR1:vec4<f32>, lightU1:vec4<f32>,
 info:vec4<u32>, config:vec4<u32>, limits:vec4<u32>,
 co:array<vec4<f32>,40>, low:array<vec4<f32>,10>, high:array<vec4<f32>,10>,
 capsA:array<vec4<f32>,20>,capsB:array<vec4<f32>,20>,
}
@group(0) @binding(0) var<uniform> g:Params;
@group(0) @binding(1) var<storage,read_write> hits:array<vec4<f32>>;
@group(0) @binding(2) var<storage,read_write> stats:array<atomic<u32>>;
@group(0) @binding(3) var<storage,read_write> surfels:array<vec4<f32>>;
@group(0) @binding(4) var<storage,read_write> depths:array<atomic<u32>>;
@group(0) @binding(5) var<storage,read_write> winners:array<atomic<u32>>;
@group(0) @binding(6) var<storage,read_write> counts:array<atomic<u32>>;
@group(0) @binding(7) var<storage,read_write> candidates:array<u32>;
@group(0) @binding(8) var<storage,read_write> outputValues:array<vec4<f32>>;
@group(0) @binding(9) var shadow0:texture_2d<f32>;
@group(0) @binding(10) var shadow1:texture_2d<f32>;
@group(0) @binding(11) var screen:texture_storage_2d<rgba8unorm,write>;
@group(0) @binding(12) var shadowOut:texture_storage_2d<r32float,write>;
const TAU:f32=6.28318530718;
const FAR:f32=1.e9;
fn linearId(id:vec3<u32>)->u32{return id.x+id.y*16384u;}
fn pitch()->f32{return g.profile.x;}
fn size()->vec2<u32>{return g.info.xy;}
fn shift()->vec3<f32>{return vec3<f32>(-f32(g.limits.x)*pitch()*.5,-f32(g.limits.y)*pitch()*.25,0.);}
fn hash(x:i32)->f32{var n=(u32(x)^4291u)*73244475u;n=(n^(n>>16u))*73244475u;return f32(n^(n>>16u))/4294967296.;}
fn phase(t:f32,lane:f32)->f32{return hash(i32(floor(t)+lane*4099.))*TAU;}
fn curve(t:f32)->vec3<f32>{let v=fract(t)*10.;let i=min(9u,u32(floor(v)));let x=v-f32(i);return ((g.co[i*4u+3u].xyz*x+g.co[i*4u+2u].xyz)*x+g.co[i*4u+1u].xyz)*x+g.co[i*4u].xyz;}
fn centre(t:f32,lane:f32)->vec3<f32>{let q=curve(t);return vec3<f32>(floor(t)+q.x+.5,lane*.5+q.y,q.z)*pitch();}
struct Frame{P:vec3<f32>,T:vec3<f32>,B:vec3<f32>,W:vec3<f32>,r:f32,}
fn frame(t:f32,lane:f32)->Frame{let P=centre(t,lane);let T=normalize(centre(t+.0005,lane)-centre(t-.0005,lane));let B=normalize(cross(T,vec3<f32>(0.,0.,1.))+vec3<f32>(1.e-12));let W=normalize(cross(B,T));let r=g.profile.y*(1.+.038*sin(fract(t)*21.+phase(t,lane))+.022*sin(fract(t)*49.+phase(t,lane)*3.));return Frame(P,T,B,W,r);}
fn yarn(t:f32,theta:f32,lane:f32)->vec3<f32>{let f=frame(t,lane);let envelope=1.+.055*cos(3.*(theta+fract(t)*TAU*2.8*.55))+.022*sin(5.*theta+phase(t,lane)+fract(t)*11.);return f.P+(f.B*cos(theta)+f.W*sin(theta))*f.r*envelope;}
fn boxSpan(o:vec3<f32>,d:vec3<f32>,lo:vec3<f32>,hi:vec3<f32>)->vec2<f32>{var a=-FAR;var b=FAR;for(var k=0u;k<3u;k++){if(abs(d[k])<1.e-12){if(o[k]<lo[k]||o[k]>hi[k]){return vec2<f32>(FAR,-FAR);}}else{let x=(lo[k]-o[k])/d[k];let y=(hi[k]-o[k])/d[k];a=max(a,min(x,y));b=min(b,max(x,y));}}return vec2<f32>(a,b);}
fn capsuleMayHit(ro:vec3<f32>,rd:vec3<f32>,offset:vec3<f32>,seg:u32)->bool{for(var part=0u;part<2u;part++){let ca=g.capsA[seg*2u+part];let cb=g.capsB[seg*2u+part];var a=offset+ca.xyz-ro;var b=offset+cb.xyz-ro;let margin=max(.001,1.e-5*max(length(a),length(b)));a-=rd*dot(a,rd);b-=rd*dot(b,rd);let d=b-a;let t=clamp(-dot(a,d)/max(1.e-18,dot(d,d)),0.,1.);let q=a+d*t;let bound=ca.w+margin;if(dot(q,q)<=bound*bound){return true;}}return false;}
fn solve(ro:vec3<f32>,rd:vec3<f32>,lane:f32,lower:f32,upper:f32,seed:f32)->vec4<f32>{var t=mix(lower,upper,seed);let f=frame(t,lane);var theta=atan2(dot(-rd,f.W),dot(-rd,f.B));var depth=dot(yarn(t,theta,lane)-ro,rd);
 for(var it=0u;it<13u;it++){let S=yarn(t,theta,lane);let r=S-ro-rd*depth;if(dot(r,r)<.00000025){break;}let du=(yarn(t+.00002,theta,lane)-yarn(t-.00002,theta,lane))/.00004;let dv=(yarn(t,theta+.0002,lane)-yarn(t,theta-.0002,lane))/.0004;let crossV=cross(dv,-rd);let det=dot(du,crossV);if(abs(det)<1.e-9){break;}let delta=vec3<f32>(dot(r,crossV),dot(du,cross(r,-rd)),dot(du,cross(dv,r)))/det;t-=clamp(delta.x,-.08,.08);theta-=clamp(delta.y,-.9,.9);depth-=clamp(delta.z,-pitch(),pitch());if(t<lower-.12||t>upper+.12){break;}}
 let residual=length(yarn(t,theta,lane)-ro-rd*depth);let valid=residual<.001&&t>=lower-.000001&&t<=upper+.000001&&depth>0.;return vec4<f32>(t,theta,depth,select(0.,1.,valid));}
fn ray(p:vec2<u32>,s:u32)->vec3<f32>{let off=vec2<f32>(f32(s&1u),f32(s>>1u))*.5+.25;var q=(vec2<f32>(p)+off)/vec2<f32>(size())*2.-1.;q.y=-q.y;q.x*=f32(g.info.x)/f32(g.info.y);return normalize(g.forward.xyz+g.profile.w*(g.right.xyz*q.x+g.up.xyz*q.y));}
fn emptyHit()->vec4<f32>{return vec4<f32>(0.,0.,FAR,-1.);}
fn offsetOf(id:u32)->vec3<f32>{let needle=id/10u;return vec3<f32>(f32(needle%g.limits.x)*pitch(),f32(needle/g.limits.x)*pitch()*.5,0.);}
fn testSegment(id:u32,ro:vec3<f32>,rd:vec3<f32>,prior:vec4<f32>)->vec4<f32>{var best=prior;let seg=id%10u;let offset=offsetOf(id);let box=boxSpan(ro,rd,offset+g.low[seg].xyz,offset+g.high[seg].xyz);if(box.x>box.y||box.y<0.||box.x>best.z||(g.config.w!=0u&&!capsuleMayHit(ro,rd,offset,seg))){return best;}let needle=id/10u;let lower=f32(needle%g.limits.x)+f32(seg)*.1;let lane=f32(needle/g.limits.x);for(var trial=0u;trial<3u;trial++){var seed=.5;if(trial==1u){seed=.12;}if(trial==2u){seed=.88;}let h=solve(ro,rd,lane,lower,lower+.1,seed);if(h.w>0.&&h.z<best.z){best=vec4<f32>(h.xyz,lane);}}return best;}
fn referenceQuery(ro:vec3<f32>,rd:vec3<f32>)->vec4<f32>{let r=g.profile.y;let lo=vec3<f32>(-r,-pitch()*.5-r,-pitch()*.3-r*1.15);let hi=vec3<f32>(f32(g.limits.x)*pitch()+r,f32(g.limits.y)*pitch()*.5+pitch()*.7+r,pitch()*.3+r*1.15);let span=boxSpan(ro,rd,lo,hi);var best=emptyHit();if(span.x>span.y||span.y<0.){return best;}let a=ro+rd*max(0.,span.x);let b=ro+rd*span.y;let low=max(vec2<i32>(0),vec2<i32>(floor(min(a.xy,b.xy)/vec2<f32>(pitch(),pitch()*.5)))-vec2<i32>(1,2));let high=min(vec2<i32>(g.limits.xy)-vec2<i32>(1),vec2<i32>(floor(max(a.xy,b.xy)/vec2<f32>(pitch(),pitch()*.5)))+vec2<i32>(1,2));for(var y=low.y;y<=high.y;y++){for(var x=low.x;x<=high.x;x++){for(var seg=0u;seg<10u;seg++){best=testSegment((u32(y)*g.limits.x+u32(x))*10u+seg,ro,rd,best);}}}return best;}
fn projectBox(lo:vec3<f32>,hi:vec3<f32>)->vec4<i32>{var mn=vec2<f32>(FAR);var mx=vec2<f32>(-FAR);var nz=FAR;var fz=-FAR;for(var i=0u;i<8u;i++){let select3=vec3<f32>(f32(i&1u),f32((i>>1u)&1u),f32((i>>2u)&1u));let p=lo+(hi-lo)*select3+shift()-g.eye.xyz;let z=dot(p,g.forward.xyz);nz=min(nz,z);fz=max(fz,z);let q=vec2<f32>(dot(p,g.right.xyz)/(g.profile.w*f32(g.info.x)/f32(g.info.y)),-dot(p,g.up.xyz)/g.profile.w)/max(z,.01);let px=(q*.5+.5)*vec2<f32>(size());mn=min(mn,px);mx=max(mx,px);}if(fz<=.01){return vec4<i32>(1,1,0,0);}if(nz<=.01){return vec4<i32>(0,0,vec2<i32>(size())-vec2<i32>(1));}if(mx.x<0.||mx.y<0.||mn.x>=f32(g.info.x)||mn.y>=f32(g.info.y)){return vec4<i32>(1,1,0,0);}return vec4<i32>(max(vec2<i32>(0),vec2<i32>(floor(mn))-vec2<i32>(1)),min(vec2<i32>(size())-vec2<i32>(1),vec2<i32>(ceil(mx))+vec2<i32>(1)));}
fn shadowVisibility(p:vec3<f32>,which:u32)->f32{if(g.config.z==0u){return 1.;}var eye=g.lightEye0.xyz;var f=g.lightF0.xyz;var r=g.lightR0.xyz;var u=g.lightU0.xyz;if(which==1u){eye=g.lightEye1.xyz;f=g.lightF1.xyz;r=g.lightR1.xyz;u=g.lightU1.xyz;}let q=p+shift()-eye;let z=dot(q,f);if(z<=.01){return 1.;}let uv=vec2<f32>(dot(q,r),-dot(q,u))/(z*g.profile.w)*.5+.5;if(any(uv<vec2<f32>(0.))||any(uv>=vec2<f32>(1.))){return 1.;}let at=vec2<i32>(uv*f32(g.limits.w));let d=length(q);var sum=0.;for(var j=0u;j<4u;j++){let ij=clamp(at+vec2<i32>(i32(j&1u),i32(j>>1u))-vec2<i32>(1),vec2<i32>(0),vec2<i32>(i32(g.limits.w)-1));var v=textureLoad(shadow0,ij,0).x;if(which==1u){v=textureLoad(shadow1,ij,0).x;}sum+=select(0.,1.,d-.6<=v);}return sum*.25;}
fn arc(t:f32)->f32{return 3.926862431999*t-.019512499729*sin(12.56637061436*t)+.012534954656*sin(25.13274122872*t)+.000256499088*sin(37.69911184308*t)-.000120229580*sin(50.26548245744*t)-.000009090432*sin(62.8318530718*t)+.000002920105*sin(75.39822368616*t);}
fn yarnLight(T:vec3<f32>,N:vec3<f32>,V:vec3<f32>,L:vec3<f32>,energy:vec3<f32>,dye:vec3<f32>)->vec3<f32>{let nl=max(dot(N,L),0.);let nv=max(dot(N,V),.02);let H=normalize(L+V);let nh=max(dot(N,H),0.);let vh=max(dot(V,H),0.);let a=.88*.88;let a2=a*a;let den=nh*nh*(a2-1.)+1.;let D=a2/(3.141592654*den*den);let gv=nl*sqrt(nv*nv*(1.-a2)+a2);let gl=nv*sqrt(nl*nl*(1.-a2)+a2);let G=.5/max(.0001,gv+gl);let F=.04+.96*pow(1.-vh,5.);let transverse=sqrt(max(0.,1.-pow(dot(T,L),2.)));let broad=.62*nl+.23*transverse*clamp(.55+.55*dot(N,L),0.,1.)+.15*nl/(nl+nv+.05);let diffuse=mix(dye*nl/3.141592654,dye*broad/3.141592654,vec3<f32>(.3));let sheen=.07*pow(max(0.,1.-nh*nh),.58)*nl;return energy*(diffuse+vec3<f32>(D*G*F*nl*.7)+vec3<f32>(.855,.791,.651)*sheen);}
fn modulo(x:f32,y:f32)->f32{return x-floor(x/y)*y;}
fn normalAt(h:vec4<f32>)->vec3<f32>{let f=frame(h.x,h.w);return normalize(f.B*cos(h.y)+f.W*sin(h.y));}
fn shade(h:vec4<f32>,rd:vec3<f32>)->vec3<f32>{if(h.w<0.){return vec3<f32>(.038);}let f=frame(h.x,h.w);var n=normalize(f.B*cos(h.y)+f.W*sin(h.y));if(dot(n,-rd)<0.){n=-n;}var dye=vec3<f32>(.6514,.552,.4287)*(1.+.028*sin(arc(h.x)*pitch()*.67+h.w*1.47));let mmpp=max(.0001,h.z*2.*g.profile.w/f32(g.info.y));let turn=fract(h.x)*TAU*.55*1.6;let coord=(h.y+turn)/TAU*96.;var micro=0.;var pigment=0.;var weight=0.;for(var j=-2;j<=2;j++){let ang=floor(coord)+f32(j);let index=modulo(modulo(ang,96.)*85.,96.);let id=i32(round(h.w*997.+floor(h.x)*491.+index*37.));let seed=hash(id+9);let at=(ang+seed*.55)/96.*TAU-turn+.075*sin(fract(h.x)*57.+seed*27.);let delta=atan2(sin(h.y-at),cos(h.y-at))*f.r;let sigma=max(.012,mmpp*.43);let w=exp(-.5*delta*delta/(sigma*sigma));micro+=w*delta/sigma;pigment+=w*(.72+.47*hash(id+1));weight+=w;}let resolved=exp(-.5*pow(mmpp/f.r/TAU*96.*.42,2.));var c=.86;if(weight>.0001){c=pigment/weight;}dye*=mix(.96,c,resolved*.72);n=normalize(n+normalize(cross(f.T,n))*.24*micro*resolved);let groove=.5+.5*cos(3.*h.y-arc(h.x)*pitch()*TAU/g.profile.z);let gr=exp(-.5*mmpp*mmpp*(9./(f.r*f.r)+TAU*TAU/(g.profile.z*g.profile.z)));dye*=1.-.045*groove*gr;let p=yarn(h.x,h.y,h.w);let key=normalize(g.lightEye0.xyz-p-shift());let rim=normalize(g.lightEye1.xyz-p-shift());return yarnLight(f.T,n,-rd,key,vec3<f32>(3.5,2.8,2.05)*shadowVisibility(p,0u),dye)+yarnLight(f.T,n,-rd,rim,vec3<f32>(1.4,1.85,2.7)*shadowVisibility(p,1u),dye)+dye*.14;}
@compute @workgroup_size(64) fn prepare(@builtin(global_invocation_id) gid:vec3<u32>){let id=linearId(gid);let per=g.config.x*g.config.y;if(id>=g.limits.x*g.limits.y*per){return;}let needle=id/per;let k=id%per;let t=f32(needle%g.limits.x)+(f32(k/g.config.y)+.5)/f32(g.config.x);let a=(f32(k%g.config.y)+.5)*TAU/f32(g.config.y);let lane=f32(needle/g.limits.x);let p=yarn(t,a,lane);let du=(yarn(t+.00002,a,lane)-yarn(t-.00002,a,lane))/.00004/f32(g.config.x);let dv=(yarn(t,a+.0002,lane)-yarn(t,a-.0002,lane))/.0004*TAU/f32(g.config.y);surfels[id*3u]=vec4<f32>(p,t);surfels[id*3u+1u]=vec4<f32>(du,a);surfels[id*3u+2u]=vec4<f32>(dv,lane);}
@compute @workgroup_size(64) fn clear(@builtin(global_invocation_id) gid:vec3<u32>){let id=linearId(gid);if(id==0u){atomicStore(&stats[0],0u);}if(g.config.w==0u){if(id<g.info.z*((g.info.y+7u)/8u)){atomicStore(&counts[id],0u);}}else if(id<g.info.x*g.info.y*4u){atomicStore(&depths[id],bitcast<u32>(FAR));atomicStore(&winners[id],0xffffffffu);}}
@compute @workgroup_size(64) fn bin(@builtin(global_invocation_id) gid:vec3<u32>){let id=linearId(gid);if(id>=g.limits.x*g.limits.y*10u){return;}let seg=id%10u;let o=offsetOf(id);var r=projectBox(o+g.low[seg].xyz,o+g.high[seg].xyz);if(r.x>r.z){return;}r/=vec4<i32>(8);for(var y=r.y;y<=r.w;y++){for(var x=r.x;x<=r.z;x++){let tile=u32(y)*g.info.z+u32(x);let at=atomicAdd(&counts[tile],1u);if(at<g.limits.z){candidates[tile*g.limits.z+at]=id;}else{atomicAdd(&stats[0],1u);}}}}
@compute @workgroup_size(64) fn query(@builtin(global_invocation_id) gid:vec3<u32>){let id=linearId(gid);if(id>=g.info.x*g.info.y){return;}let p=vec2<u32>(id%g.info.x,id/g.info.x);let tile=p.y/8u*g.info.z+p.x/8u;let ro=g.eye.xyz-shift();for(var s=0u;s<4u;s++){let rd=ray(p,s);var best=emptyHit();if(g.config.w==0u){best=referenceQuery(ro,rd);}else{let n=min(atomicLoad(&counts[tile]),g.limits.z);for(var j=0u;j<n;j++){best=testSegment(candidates[tile*g.limits.z+j],ro,rd,best);}}hits[id*4u+s]=best;}}
@compute @workgroup_size(64) fn splat(@builtin(global_invocation_id) gid:vec3<u32>){let id=linearId(gid);if(id>=g.limits.x*g.limits.y*g.config.x*g.config.y){return;}let s0=surfels[id*3u];let s1=surfels[id*3u+1u];let s2=surfels[id*3u+2u];let P=s0.xyz;let A=s1.xyz;let B=s2.xyz;let N=cross(A,B);let ro=g.eye.xyz-shift();if(dot(N,ro-P)<=0.){return;}let ext=.72*(abs(A)+abs(B));let rect=projectBox(P-ext,P+ext);if(rect.x>rect.z){return;}let aa=dot(A,A);let ab=dot(A,B);let bb=dot(B,B);let det=aa*bb-ab*ab;if(det<1.e-14){return;}for(var y=rect.y;y<=rect.w;y++){for(var x=rect.x;x<=rect.z;x++){for(var s=0u;s<4u;s++){let rd=ray(vec2<u32>(u32(x),u32(y)),s);let den=dot(N,rd);if(den>=-1.e-10){continue;}let depth=dot(N,P-ro)/den;if(depth<=.01||depth>=FAR){continue;}let q=ro+rd*depth-P;let qa=dot(q,A);let qb=dot(q,B);let uv=vec2<f32>(qa*bb-qb*ab,qb*aa-qa*ab)/det;if(dot(uv,uv)>.5184){continue;}let t=s0.w+uv.x/f32(g.config.x);if(t<f32(i32(s0.w))||t>=f32(i32(s0.w)+1)){continue;}let at=(u32(y)*g.info.x+u32(x))*4u+s;let z=bitcast<u32>(depth);if(g.config.w==0u){atomicMin(&depths[at],z);}else if(atomicLoad(&depths[at])==z){atomicMin(&winners[at],id);}}}}}
@compute @workgroup_size(64) fn resolve(@builtin(global_invocation_id) gid:vec3<u32>){let id=linearId(gid);if(id>=g.info.x*g.info.y){return;}let p=vec2<u32>(id%g.info.x,id/g.info.x);for(var s=0u;s<4u;s++){let at=id*4u+s;let winner=atomicLoad(&winners[at]);var h=emptyHit();if(winner!=0xffffffffu){let s0=surfels[winner*3u];let s1=surfels[winner*3u+1u];let s2=surfels[winner*3u+2u];let A=s1.xyz;let B=s2.xyz;let d=bitcast<f32>(atomicLoad(&depths[at]));let q=g.eye.xyz-shift()+ray(p,s)*d-s0.xyz;let aa=dot(A,A);let ab=dot(A,B);let bb=dot(B,B);let det=aa*bb-ab*ab;let uv=vec2<f32>(dot(q,A)*bb-dot(q,B)*ab,dot(q,B)*aa-dot(q,A)*ab)/det;h=vec4<f32>(s0.w+uv.x/f32(g.config.x),s1.w+uv.y*TAU/f32(g.config.y),d,s2.w);}hits[at]=h;}}
@compute @workgroup_size(64) fn shading(@builtin(global_invocation_id) gid:vec3<u32>){let id=linearId(gid);if(id>=g.info.x*g.info.y){return;}let p=vec2<u32>(id%g.info.x,id/g.info.x);var color=vec3<f32>(0.);var normal=vec3<f32>(0.);var depth=FAR;for(var s=0u;s<4u;s++){let h=hits[id*4u+s];color+=shade(h,ray(p,s))*.25;if(h.w>=0.&&h.z<depth){depth=h.z;normal=normalAt(h);}}color=pow(max(color/(vec3<f32>(1.)+color),vec3<f32>(0.)),vec3<f32>(1./2.2));outputValues[id]=vec4<f32>(color,1.);outputValues[id+g.info.x*g.info.y]=vec4<f32>(normal,depth);textureStore(screen,vec2<i32>(p),vec4<f32>(color,1.));}
@compute @workgroup_size(64) fn shadowExport(@builtin(global_invocation_id) gid:vec3<u32>){let id=linearId(gid);if(id>=g.info.x*g.info.y){return;}var d=FAR;for(var s=0u;s<4u;s++){d=min(d,hits[id*4u+s].z);}textureStore(shadowOut,vec2<i32>(i32(id%g.info.x),i32(id/g.info.x)),vec4<f32>(d));}
