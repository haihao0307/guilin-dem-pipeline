{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaopu.fabric.shader-rule-draft/1",
  "type": "object",
  "required": [
    "schema",
    "materialId",
    "revision",
    "status",
    "applied",
    "source",
    "classification",
    "units",
    "channels",
    "rules",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "kaopu.fabric.shader-rule-draft/1"
    },
    "materialId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "const": "draft"
    },
    "applied": {
      "const": false
    },
    "source": {
      "type": "object"
    },
    "classification": {
      "type": "object"
    },
    "units": {
      "type": "object"
    },
    "channels": {
      "type": "object"
    },
    "rules": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "channel",
          "expression"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "channel": {
            "enum": [
              "baseColor",
              "roughness",
              "anisotropy",
              "sheen",
              "transmission",
              "thickness",
              "normal",
              "displacement"
            ]
          },
          "expression": {
            "type": "string",
            "maxLength": 10000
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 20000
    }
  }
}