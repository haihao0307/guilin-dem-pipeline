{
  "format": "ocean-mother-output-policy",
  "version": "1.1.0",
  "effectiveDate": "2026-09-04",
  "defaultDeliverable": "interactive-3d-html-webgl",
  "userFacingResultMustBeRunnable": true,
  "imageGenerationAllowedOnlyWhenExplicitlyRequestedByUser": true,
  "generatedImagesAllowedAsImplementationSubstitute": false,
  "staticScreenshotsAllowedAsDeliverySubstitute": false,
  "conceptArtAllowedAsDeliverySubstitute": false,
  "internalBrowserScreenshots": "QA evidence only and never the user-facing deliverable",
  "continueCommandMeaning": "continue implementation, browser verification and publication of the interactive 3D HTML",
  "runtimeAssetPolicy": {
    "imageTextures": 0,
    "screenshotBackgrounds": 0,
    "externalModels": 0,
    "externalCdn": 0
  },
  "scope": [
    "Ocean Mother nearshore",
    "Ocean Mother deep ocean",
    "Ocean Mother standalone HTML",
    "Ocean Mother online workbench"
  ],
  "approval": {
    "visualApproved": false,
    "productionApproved": false
  }
}
