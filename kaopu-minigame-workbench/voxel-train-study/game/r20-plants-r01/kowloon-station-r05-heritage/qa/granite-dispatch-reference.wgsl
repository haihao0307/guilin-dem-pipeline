// Exact bdcd C candidate resolver and near/far function; names only changed.
fn referenceCPhysicalDistance(h:HitField,p:vec3<f32>,st:StationState)->f32{if(!stationNativeId(h.id)){return h.d;}if(abs(h.d)<.045){return evaluateStationGeometry(h,p,st).d;}return sign(h.d)*max(abs(h.d)-.03,0.);}
fn referenceCResolveCandidates(p:vec3<f32>)->HitField{if(stationCandidateOverflow){return HitField(0.,999u,p,0.,0.,vec3<f32>(1.),0.);}var h=HitField(10000.,0u,p,0.,10000.,vec3<f32>(1.),0.);let st=resolveStationState(p);for(var i=0u;i<stationCandidates.count;i++){var candidate=stationCandidates.items[i];let d=candidate.d;let id=candidate.id;let native=stationNativeId(id);if(d-select(0.,.03001,native)>stationCandidateUpper){continue;}if(native&&d-.03<h.d){candidate.d=referenceCPhysicalDistance(candidate,p,st);}if(candidate.d<h.d){h=candidate;}}return h;}
