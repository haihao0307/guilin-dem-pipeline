{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"kaopu.street.resolved/1",
 "title":"KST1 resolved architectural recipe",
 "type":"object",
 "required":["schema","instrument","object","units","axis","construction","appearance","motion","performance","provenance"],
 "properties":{
  "schema":{"const":"kaopu.street.resolved/1"},
  "instrument":{"type":"object","required":["id","version","abi"],"properties":{"id":{"const":"kaopu.street.architecture"},"version":{"const":"1.0.0"},"abi":{"const":"KST1"}}},
  "object":{"type":"object","required":["id","seed"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"seed":{"type":"integer","minimum":0,"maximum":4294967295}}},
  "units":{"const":"metre"},"axis":{"const":"Y_UP"},
  "construction":{"type":"object","required":["buildings","railClearance","windowCageDensity","signDensity","wireSag"],"properties":{"windowCageDensity":{"type":"number","minimum":0,"maximum":1},"signDensity":{"type":"number","minimum":0,"maximum":1},"wireSag":{"type":"number","minimum":0,"maximum":0.9},"buildings":{"type":"array","minItems":1,"maxItems":2,"items":{"type":"object","required":["id","x","frontZ","width","depth","floors","floorHeight","groundHeight","bays","facade","age","repair","shops"],"properties":{"floors":{"type":"integer","minimum":2,"maximum":8},"bays":{"type":"integer","minimum":2,"maximum":5},"age":{"type":"number","minimum":0,"maximum":1},"repair":{"type":"number","minimum":0,"maximum":1},"facade":{"enum":["brick_shophouse","timber_verandah"]}}}}}},
  "motion":{"type":"object","required":["timeSource","wind"],"properties":{"timeSource":{"const":"host.elapsed"}}},
  "provenance":{"type":"object","required":["externalMesh","externalImageTextures"],"properties":{"externalMesh":{"const":false},"externalImageTextures":{"const":false}}}
 },
 "$comment":"This JSON schema describes core structure; instrument.validate is authoritative for all numeric/recipe support limits and recursively rejects baked-asset fields. It does not fetch or resolve remote schemas."
}
