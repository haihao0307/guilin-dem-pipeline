{
  "schema": "wenzhou_osm_hydrology@2.0.0",
  "project": "wenzhou-v200-17tile-truth-hydrology-rebuild",
  "source": {
    "project": "OpenStreetMap",
    "license": "ODbL 1.0",
    "attribution": "© OpenStreetMap contributors",
    "primaryEndpoint": "https://overpass-api.de/api/interpreter",
    "fallbackEndpoints": [
      "https://overpass.private.coffee/api/interpreter",
      "https://overpass.kumi.systems/api/interpreter"
    ],
    "endpointPolicy": "rotate endpoints on failure and preserve the selected endpoint in each tile receipt"
  },
  "domain": {
    "wgs84Bounds": [119.84414553534705, 27.293797468756548, 122.04907102781185, 29.286519694859074],
    "projectedCrs": "EPSG:32651",
    "projectedClipBounds": [187912.5, 3019612.5, 407350.0, 3243587.5],
    "truthCogSha256": "c1da93dca81abc2ee9edaa47496d80c6fa36155e11c9b61464f4f2b547659b43"
  },
  "tiling": {
    "columns": 3,
    "rows": 3,
    "overlapDegrees": 0.002,
    "secondsBetweenSuccessfulTiles": 4
  },
  "query": {
    "coastline": {
      "element": "way",
      "filter": "natural=coastline"
    },
    "waterways": {
      "element": "way",
      "filterRegex": "waterway=^(river|stream|canal|tidal_channel)$"
    },
    "timeoutSeconds": 240,
    "output": "way tags, node ids and inline geometry; no recursive node body",
    "overpassQlOutputStatement": "out tags geom qt",
    "nodeReferenceStatus": "not_evaluable_when_overpass_inline_geometry_omits_node_ids"
  },
  "retry": {
    "attemptsPerEndpoint": 2,
    "http429PauseSeconds": 40,
    "otherRetryPauseSeconds": 10,
    "rotateEndpointBeforeRetry": true
  },
  "derived": {
    "preserveSourceCoordinates": true,
    "preserveSourceWayIds": true,
    "clipProjectedGeometry": true,
    "mutateSourceGeometry": false,
    "riverWidthMayModifyCenterline": false,
    "minimumWayVertexCount": 2,
    "outputRoot": "projects/wenzhou/v200/data/hydrology/osm",
    "reportRoot": "projects/wenzhou/v200/reports"
  },
  "qa": {
    "maximumOutOfBoundsVertices": 0,
    "maximumDuplicatePartIds": 0,
    "maximumMissingWayGeometry": 0,
    "maximumIntroducedSelfIntersections": 0,
    "requireCoastlineFeatures": true,
    "requireWaterwayFeatures": true,
    "estuaryConnectivityStatus": "pending_named_network_and_coastline_topology_stage",
    "manualGeometryAllowed": false
  }
}
